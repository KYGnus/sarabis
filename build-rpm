#!/bin/bash

set -Eeuo pipefail

# ============================================================
# sarabis Security Analyzer
# RPM Package Builder
# ============================================================

APP_NAME="sarabis"
VERSION="1.1.0"
RELEASE="1"
ARCHITECTURE="noarch"

MAINTAINER="KYGnus <kygnus.co@proton.me>"

DESCRIPTION="sarabis Security Analyzer - Comprehensive remote Linux system security analysis platform"

APP_URL="http://localhost:8080"
PROJECT_URL="https://kygnus.github.io/"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ============================================================
# Project source
# ============================================================

APP_SOURCE_DIR="${SCRIPT_DIR}/app"
REQUIREMENTS_FILE="${SCRIPT_DIR}/requirements.txt"
SETUP_FILE="${SCRIPT_DIR}/setup.py"

# ============================================================
# Build directories
# ============================================================

BUILD_DIR="${SCRIPT_DIR}/rpm_package"

RPM_TOPDIR="${BUILD_DIR}/rpmbuild"

SOURCES_DIR="${RPM_TOPDIR}/SOURCES"
SPECS_DIR="${RPM_TOPDIR}/SPECS"
BUILD_DIR_RPM="${RPM_TOPDIR}/BUILD"
BUILDROOT_DIR="${RPM_TOPDIR}/BUILDROOT"
RPMS_DIR="${RPM_TOPDIR}/RPMS"
SRPMS_DIR="${RPM_TOPDIR}/SRPMS"

TMP_DIR="${BUILD_DIR}/tmp"

SOURCE_ROOT="${BUILD_DIR}/${APP_NAME}-${VERSION}"

SOURCE_TARBALL="${SOURCES_DIR}/${APP_NAME}-${VERSION}.tar.gz"

SPEC_FILE="${SPECS_DIR}/${APP_NAME}.spec"

# ============================================================
# Output
# ============================================================

DIST_DIR="${SCRIPT_DIR}/dist"

FINAL_RPM="${DIST_DIR}/${APP_NAME}-${VERSION}-${RELEASE}.${ARCHITECTURE}.rpm"

# ============================================================
# Package paths
# ============================================================

APP_INSTALL_DIR="/usr/share/${APP_NAME}"
APP_CODE_DIR="${APP_INSTALL_DIR}/app"

CONFIG_DIR="/etc/${APP_NAME}"

DATA_DIR="/var/lib/${APP_NAME}"
UPLOAD_DIR="${DATA_DIR}/uploads"
REPORT_DIR="${DATA_DIR}/reports"
LOG_DIR="${DATA_DIR}/logs"

BIN_FILE="/usr/bin/${APP_NAME}"

DESKTOP_FILE="/usr/share/applications/${APP_NAME}.desktop"

SYSTEMD_FILE="/usr/lib/systemd/system/${APP_NAME}.service"

DOC_DIR="/usr/share/doc/packages/${APP_NAME}"

# ============================================================
# Functions
# ============================================================

die()
{
    echo
    echo "============================================================"
    echo "ERROR"
    echo "============================================================"
    echo
    echo "$*"
    echo
    exit 1
}

command_exists()
{
    command -v "$1" >/dev/null 2>&1
}

# ============================================================
# Header
# ============================================================

echo
echo "============================================================"
echo "        sarabis Security Analyzer RPM Builder"
echo "============================================================"
echo
echo "Application : ${APP_NAME}"
echo "Version     : ${VERSION}"
echo "Release     : ${RELEASE}"
echo "Architecture: ${ARCHITECTURE}"
echo "Project     : ${PROJECT_URL}"
echo "Web URL     : ${APP_URL}"
echo

# ============================================================
# Root check
# ============================================================

if [ "${EUID}" -eq 0 ]; then

    die "Do not run this script as root.

Use:

    ./build-rpm"

fi

# ============================================================
# Check application
# ============================================================

echo "🔍 Checking application source..."

if [ ! -d "${APP_SOURCE_DIR}" ]; then
    die "Application directory not found:

${APP_SOURCE_DIR}"
fi

if [ ! -f "${APP_SOURCE_DIR}/main.py" ]; then
    die "main.py was not found:

${APP_SOURCE_DIR}/main.py"
fi

echo "✅ app/main.py found"

# ============================================================
# Check RPM tools
# ============================================================

echo
echo "🔍 Checking RPM build tools..."

if ! command_exists rpm || ! command_exists rpmbuild; then

    echo "⚠️ rpm/rpmbuild is missing."

    if command_exists zypper; then

        echo "📦 Installing rpm-build..."

        sudo zypper --non-interactive install rpm rpm-build

    elif command_exists dnf; then

        echo "📦 Installing rpm-build..."

        sudo dnf install rpm rpm-build

    elif command_exists yum; then

        echo "📦 Installing rpm-build..."

        sudo yum install rpm rpm-build

    else

        die "Cannot install RPM build tools automatically."

    fi

fi

command_exists rpm \
    || die "rpm command is unavailable."

command_exists rpmbuild \
    || die "rpmbuild command is unavailable."

echo "✅ rpm:      $(command -v rpm)"
echo "✅ rpmbuild: $(command -v rpmbuild)"

# ============================================================
# Python
# ============================================================

echo
echo "🔍 Checking Python..."

if ! command_exists python3; then
    die "python3 is required."
fi

echo "✅ $(python3 --version)"

# ============================================================
# Clean build
# ============================================================

echo
echo "🧹 Cleaning previous RPM build..."

rm -rf "${BUILD_DIR}"
rm -rf "${DIST_DIR}"

mkdir -p \
    "${SOURCES_DIR}" \
    "${SPECS_DIR}" \
    "${BUILD_DIR_RPM}" \
    "${BUILDROOT_DIR}" \
    "${RPMS_DIR}" \
    "${SRPMS_DIR}" \
    "${TMP_DIR}" \
    "${DIST_DIR}"

echo "✅ Build directories created."

# ============================================================
# Source tree
# ============================================================

echo
echo "📁 Creating source tree..."

mkdir -p \
    "${SOURCE_ROOT}/app" \
    "${SOURCE_ROOT}/etc/sarabis" \
    "${SOURCE_ROOT}/usr/bin" \
    "${SOURCE_ROOT}/usr/share/applications" \
    "${SOURCE_ROOT}/usr/lib/systemd/system" \
    "${SOURCE_ROOT}/usr/share/doc/packages/sarabis"

# ============================================================
# Application
# ============================================================

echo
echo "📦 Copying application..."

cp -a \
    "${APP_SOURCE_DIR}/." \
    "${SOURCE_ROOT}/app/"

if [ ! -f "${SOURCE_ROOT}/app/__init__.py" ]; then

    touch "${SOURCE_ROOT}/app/__init__.py"

fi

if [ ! -f "${SOURCE_ROOT}/app/main.py" ]; then
    die "main.py was not copied."
fi

echo "✅ Application copied."

# ============================================================
# requirements.txt
# ============================================================

HAS_REQUIREMENTS=0

if [ -f "${REQUIREMENTS_FILE}" ]; then

    echo "📦 Copying requirements.txt..."

    cp \
        "${REQUIREMENTS_FILE}" \
        "${SOURCE_ROOT}/requirements.txt"

    HAS_REQUIREMENTS=1

    echo "✅ requirements.txt copied."

else

    echo "⚠️ requirements.txt not found."

fi

# ============================================================
# setup.py
# ============================================================

HAS_SETUP=0

if [ -f "${SETUP_FILE}" ]; then

    echo "📦 Copying setup.py..."

    cp \
        "${SETUP_FILE}" \
        "${SOURCE_ROOT}/setup.py"

    HAS_SETUP=1

    echo "✅ setup.py copied."

fi

# ============================================================
# Configuration
# ============================================================

echo
echo "⚙️ Creating settings.py..."

cat > "${SOURCE_ROOT}/etc/sarabis/settings.py" <<'EOF'
# ============================================================
# sarabis Security Analyzer Configuration
# ============================================================

HOST = "127.0.0.1"

PORT = 8080

DEBUG = False

UPLOAD_DIR = "/var/lib/sarabis/uploads"

REPORT_DIR = "/var/lib/sarabis/reports"

LOG_DIR = "/var/lib/sarabis/logs"

SECRET_KEY = "sarabis-change-this-secret-key"

ADMIN_USERNAME = "admin"

ADMIN_PASSWORD = "admin"
EOF

chmod 644 "${SOURCE_ROOT}/etc/sarabis/settings.py"

echo "✅ Configuration created."

# ============================================================
# Launcher
# ============================================================

echo
echo "🖥️ Creating launcher..."

cat > "${SOURCE_ROOT}/usr/bin/sarabis" <<'EOF'
#!/bin/bash

# ============================================================
# sarabis Security Analyzer Launcher
# ============================================================

APP_DIR="/usr/share/sarabis"

APP_URL="http://localhost:8080"

VENV_PYTHON="${APP_DIR}/venv/bin/python"

MAIN_APP="${APP_DIR}/app/main.py"

DATA_DIR="/var/lib/sarabis"

LOG_DIR="${DATA_DIR}/logs"

LOG_FILE="${LOG_DIR}/sarabis.log"

# ============================================================
# Browser
# ============================================================

open_browser()
{
    if command -v xdg-open >/dev/null 2>&1; then

        xdg-open "${APP_URL}" >/dev/null 2>&1 &

    elif command -v firefox >/dev/null 2>&1; then

        firefox "${APP_URL}" >/dev/null 2>&1 &

    elif command -v chromium >/dev/null 2>&1; then

        chromium "${APP_URL}" >/dev/null 2>&1 &

    elif command -v chromium-browser >/dev/null 2>&1; then

        chromium-browser "${APP_URL}" >/dev/null 2>&1 &

    else

        echo "⚠️ Browser not found."
        echo "Open manually: ${APP_URL}"

    fi
}

# ============================================================
# Verify application
# ============================================================

if [ ! -f "${MAIN_APP}" ]; then

    echo
    echo "❌ sarabis application not found:"
    echo
    echo "   ${MAIN_APP}"
    echo

    exit 1

fi

# ============================================================
# Verify venv
# ============================================================

if [ ! -x "${VENV_PYTHON}" ]; then

    echo
    echo "❌ Python virtual environment not found:"
    echo
    echo "   ${VENV_PYTHON}"
    echo

    exit 1

fi

# ============================================================
# Log directory
# ============================================================

mkdir -p "${LOG_DIR}" 2>/dev/null || true

# ============================================================
# Check running server
# ============================================================

if command -v curl >/dev/null 2>&1; then

    if curl \
        -fsS \
        --max-time 2 \
        "${APP_URL}" \
        >/dev/null 2>&1; then

        echo
        echo "✅ sarabis is already running."
        echo
        echo "🌐 ${APP_URL}"
        echo

        open_browser

        exit 0

    fi

fi

# ============================================================
# Log file
# ============================================================

if touch "${LOG_FILE}" >/dev/null 2>&1; then

    ACTIVE_LOG="${LOG_FILE}"

else

    ACTIVE_LOG="/tmp/sarabis-${USER:-user}.log"

    touch "${ACTIVE_LOG}" >/dev/null 2>&1 || true

fi

# ============================================================
# Start
# ============================================================

echo
echo "🚀 Starting sarabis..."
echo
echo "🌐 ${APP_URL}"
echo

nohup \
    "${VENV_PYTHON}" \
    "${MAIN_APP}" \
    "$@" \
    >> "${ACTIVE_LOG}" 2>&1 &

SARABIS_PID=$!

echo "PID: ${SARABIS_PID}"

# ============================================================
# Wait
# ============================================================

echo
echo "⏳ Waiting for web interface..."

SERVER_READY=0

for i in $(seq 1 30); do

    sleep 1

    if ! kill -0 "${SARABIS_PID}" 2>/dev/null; then

        echo
        echo "❌ sarabis stopped unexpectedly."
        echo
        echo "Log:"
        echo
        echo "   ${ACTIVE_LOG}"
        echo

        tail -n 30 "${ACTIVE_LOG}" 2>/dev/null || true

        exit 1

    fi

    if command -v curl >/dev/null 2>&1; then

        if curl \
            -fsS \
            --max-time 2 \
            "${APP_URL}" \
            >/dev/null 2>&1; then

            SERVER_READY=1

            break

        fi

    fi

done

echo

if [ "${SERVER_READY}" -eq 1 ]; then

    echo "✅ sarabis web interface is ready."
    echo
    echo "🌐 ${APP_URL}"

else

    echo "⚠️ Web interface did not respond within 30 seconds."
    echo
    echo "Check:"
    echo
    echo "   ${ACTIVE_LOG}"

fi

open_browser

exit 0
EOF

chmod 755 "${SOURCE_ROOT}/usr/bin/sarabis"

echo "✅ Launcher created."

# ============================================================
# Desktop file
# ============================================================

echo
echo "🖥️ Creating desktop entry..."

cat > "${SOURCE_ROOT}/usr/share/applications/sarabis.desktop" <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application

Name=sarabis Security Analyzer
GenericName=Linux Security Analyzer

Comment=Comprehensive Linux Security Analysis Platform

Exec=/usr/bin/sarabis
TryExec=/usr/bin/sarabis

Icon=security

Terminal=false
StartupNotify=true

Categories=Network;Security;System;

Keywords=security;linux;audit;scanner;ssh;analysis;
EOF

chmod 644 "${SOURCE_ROOT}/usr/share/applications/sarabis.desktop"

echo "✅ Desktop entry created."

# ============================================================
# systemd service
# ============================================================

echo
echo "⚙️ Creating systemd service..."

cat > "${SOURCE_ROOT}/usr/lib/systemd/system/sarabis.service" <<'EOF'
[Unit]
Description=sarabis Security Analyzer
After=network.target

[Service]
Type=simple

WorkingDirectory=/usr/share/sarabis

ExecStart=/usr/share/sarabis/venv/bin/python /usr/share/sarabis/app/main.py

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

chmod 644 "${SOURCE_ROOT}/usr/lib/systemd/system/sarabis.service"

echo "✅ systemd service created."

# ============================================================
# Documentation
# ============================================================

echo
echo "📚 Creating documentation..."

HAS_README=0
HAS_LICENSE=0

cat > "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/README.SUSE" <<'EOF'
sarabis Security Analyzer
=========================

Command:

    sarabis

Web interface:

    http://localhost:8080

Configuration:

    /etc/sarabis/settings.py

Application:

    /usr/share/sarabis/

Application code:

    /usr/share/sarabis/app/

Python virtual environment:

    /usr/share/sarabis/venv/

Application data:

    /var/lib/sarabis/

Uploads:

    /var/lib/sarabis/uploads/

Reports:

    /var/lib/sarabis/reports/

Logs:

    /var/lib/sarabis/logs/

Default credentials:

    Username: admin
    Password: admin

systemd:

    sudo systemctl start sarabis
    sudo systemctl enable sarabis

Non-systemd:

    sarabis

Important:

Change the default administrator credentials before
using sarabis in a production environment.
EOF

chmod 644 "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/README.SUSE"

if [ -f "${SCRIPT_DIR}/README.md" ]; then

    cp \
        "${SCRIPT_DIR}/README.md" \
        "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/README.md"

    chmod 644 \
        "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/README.md"

    HAS_README=1

fi

if [ -f "${SCRIPT_DIR}/LICENSE" ]; then

    cp \
        "${SCRIPT_DIR}/LICENSE" \
        "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/LICENSE"

    chmod 644 \
        "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/LICENSE"

    HAS_LICENSE=1

fi

cat > "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/COPYING" <<'EOF'
Copyright (c) KYGnus

All rights reserved.
EOF

chmod 644 \
    "${SOURCE_ROOT}/usr/share/doc/packages/sarabis/COPYING"

# ============================================================
# Permissions
# ============================================================

echo
echo "🔧 Setting permissions..."

find "${SOURCE_ROOT}/app" \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \;

chmod 755 \
    "${SOURCE_ROOT}/usr/bin/sarabis"

chmod 644 \
    "${SOURCE_ROOT}/etc/sarabis/settings.py"

chmod 644 \
    "${SOURCE_ROOT}/usr/share/applications/sarabis.desktop"

chmod 644 \
    "${SOURCE_ROOT}/usr/lib/systemd/system/sarabis.service"

echo "✅ Permissions configured."

# ============================================================
# Launcher syntax
# ============================================================

echo
echo "🔍 Checking launcher syntax..."

bash -n \
    "${SOURCE_ROOT}/usr/bin/sarabis"

echo "✅ Launcher syntax OK."

# ============================================================
# Source tree
# ============================================================

echo
echo "============================================================"
echo "SOURCE TREE"
echo "============================================================"

(
    cd "${SOURCE_ROOT}"
    find . -maxdepth 5 -type f | sort
)

# ============================================================
# Source archive
# ============================================================

echo
echo "📦 Creating source archive..."

tar \
    -C "${BUILD_DIR}" \
    -czf "${SOURCE_TARBALL}" \
    "${APP_NAME}-${VERSION}"

echo "✅ Source archive:"

echo
echo "   ${SOURCE_TARBALL}"

# ============================================================
# Verify source archive
# ============================================================

echo
echo "🔍 Verifying source archive..."

tar -tzf "${SOURCE_TARBALL}" |
    grep -Fx \
        "${APP_NAME}-${VERSION}/app/main.py" \
        >/dev/null \
        || die "main.py missing from source archive."

tar -tzf "${SOURCE_TARBALL}" |
    grep -Fx \
        "${APP_NAME}-${VERSION}/usr/bin/sarabis" \
        >/dev/null \
        || die "launcher missing from source archive."

tar -tzf "${SOURCE_TARBALL}" |
    grep -Fx \
        "${APP_NAME}-${VERSION}/etc/sarabis/settings.py" \
        >/dev/null \
        || die "settings.py missing from source archive."

echo "✅ Source archive verified."

# ============================================================
# Generate SPEC
# ============================================================

echo
echo "📝 Creating SPEC file..."

cat > "${SPEC_FILE}" <<'SPECEOF'
Name:           @APP_NAME@
Version:        @VERSION@
Release:        @RELEASE@%{?dist}

Summary:        @DESCRIPTION@

License:        Proprietary

URL:            @PROJECT_URL@

Source0:        %{name}-%{version}.tar.gz

BuildArch:      noarch

# ============================================================
# Dependencies
# ============================================================

Requires:       python3
Requires:       python3-pip
Requires:       openssh
Requires:       curl
Requires:       xdg-utils

Recommends:     gcc
Recommends:     gcc-c++

%description

sarabis Security Analyzer is a Linux security analysis
platform with a Flask-based local web interface.

Web interface:

@APP_URL@

%prep

%setup -q

%build

# Python application.
# No native compilation required.

%install

# ============================================================
# Directories
# ============================================================

mkdir -p %{buildroot}%{_datadir}/sarabis
mkdir -p %{buildroot}%{_datadir}/sarabis/app

mkdir -p %{buildroot}%{_sysconfdir}/sarabis

mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/uploads
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/reports
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/logs

mkdir -p %{buildroot}%{_bindir}

mkdir -p %{buildroot}%{_datadir}/applications

mkdir -p %{buildroot}%{_unitdir}

mkdir -p %{buildroot}%{_docdir}/sarabis

# ============================================================
# Application
# ============================================================

cp -a \
    app/. \
    %{buildroot}%{_datadir}/sarabis/app/

# ============================================================
# requirements.txt
# ============================================================

@INSTALL_REQUIREMENTS@

# ============================================================
# setup.py
# ============================================================

@INSTALL_SETUP@

# ============================================================
# Configuration
# ============================================================

cp \
    etc/sarabis/settings.py \
    %{buildroot}%{_sysconfdir}/sarabis/settings.py

# ============================================================
# Launcher
# ============================================================

cp \
    usr/bin/sarabis \
    %{buildroot}%{_bindir}/sarabis

# ============================================================
# Desktop entry
# ============================================================

cp \
    usr/share/applications/sarabis.desktop \
    %{buildroot}%{_datadir}/applications/sarabis.desktop

# ============================================================
# systemd
# ============================================================

cp \
    usr/lib/systemd/system/sarabis.service \
    %{buildroot}%{_unitdir}/sarabis.service

# ============================================================
# Documentation
# ============================================================

cp \
    usr/share/doc/packages/sarabis/README.SUSE \
    %{buildroot}%{_docdir}/sarabis/README.SUSE

@INSTALL_README@

@INSTALL_LICENSE@

cp \
    usr/share/doc/packages/sarabis/COPYING \
    %{buildroot}%{_docdir}/sarabis/COPYING

# ============================================================
# Permissions
# ============================================================

chmod 755 \
    %{buildroot}%{_bindir}/sarabis

find %{buildroot}%{_datadir}/sarabis/app \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \;

# ============================================================
# PRE
# ============================================================

%pre

mkdir -p /etc/sarabis

mkdir -p /var/lib/sarabis
mkdir -p /var/lib/sarabis/uploads
mkdir -p /var/lib/sarabis/reports
mkdir -p /var/lib/sarabis/logs

exit 0

# ============================================================
# POST
# ============================================================

%post

APP_DIR="/usr/share/sarabis"

CONFIG_DIR="/etc/sarabis"

DATA_DIR="/var/lib/sarabis"

UPLOAD_DIR="/var/lib/sarabis/uploads"

REPORT_DIR="/var/lib/sarabis/reports"

LOG_DIR="/var/lib/sarabis/logs"

# ============================================================
# Runtime directories
# ============================================================

mkdir -p "${CONFIG_DIR}"

mkdir -p "${DATA_DIR}"
mkdir -p "${UPLOAD_DIR}"
mkdir -p "${REPORT_DIR}"
mkdir -p "${LOG_DIR}"

# ============================================================
# Python virtual environment
# ============================================================

if [ ! -x "${APP_DIR}/venv/bin/python" ]; then

    echo
    echo "Creating Python virtual environment..."

    if command -v python3 >/dev/null 2>&1; then

        python3 -m venv \
            "${APP_DIR}/venv" \
            || true

    fi

fi

# ============================================================
# Python dependencies
# ============================================================

if [ -x "${APP_DIR}/venv/bin/python" ] &&
   [ -f "${APP_DIR}/requirements.txt" ]; then

    echo
    echo "Installing Python dependencies..."

    "${APP_DIR}/venv/bin/python" \
        -m pip install \
        --disable-pip-version-check \
        --no-input \
        -r "${APP_DIR}/requirements.txt" \
        || {

            echo
            echo "WARNING:"
            echo "Some Python dependencies could not be installed."
            echo "RPM installation will continue."
            echo

        }

fi

# ============================================================
# Configuration
# ============================================================

if [ ! -f "${CONFIG_DIR}/settings.py" ]; then

    cat > "${CONFIG_DIR}/settings.py" <<'CONFIGEOF'
HOST = "127.0.0.1"
PORT = 8080
DEBUG = False

UPLOAD_DIR = "/var/lib/sarabis/uploads"
REPORT_DIR = "/var/lib/sarabis/reports"
LOG_DIR = "/var/lib/sarabis/logs"

SECRET_KEY = "sarabis-change-this-secret-key"

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "admin"
CONFIGEOF

    chmod 644 "${CONFIG_DIR}/settings.py"

fi

# ============================================================
# Admin credentials
# ============================================================

if [ ! -f "${APP_DIR}/.admin_credentials" ]; then

    cat > "${APP_DIR}/.admin_credentials" <<'EOF'
username=admin
password=admin
EOF

    chmod 600 "${APP_DIR}/.admin_credentials"

fi

# ============================================================
# systemd
# ============================================================

if [ -d /run/systemd/system ] &&
   command -v systemctl >/dev/null 2>&1; then

    systemctl daemon-reload \
        >/dev/null 2>&1 \
        || true

    echo
    echo "systemd detected."

    echo
    echo "Start:"
    echo
    echo "  sudo systemctl start sarabis"
    echo
    echo "Enable:"
    echo
    echo "  sudo systemctl enable sarabis"
    echo

else

    echo
    echo "Non-systemd environment detected."

    echo
    echo "Run:"
    echo
    echo "  sarabis"
    echo

fi

# ============================================================
# Desktop database
# ============================================================

if command -v update-desktop-database >/dev/null 2>&1; then

    update-desktop-database \
        /usr/share/applications \
        >/dev/null 2>&1 \
        || true

fi

echo
echo "============================================================"
echo " sarabis installation completed"
echo "============================================================"
echo
echo "Command:"
echo "  sarabis"
echo
echo "Web:"
echo "  http://localhost:8080"
echo
echo "Configuration:"
echo "  /etc/sarabis/settings.py"
echo
echo "Application:"
echo "  /usr/share/sarabis/"
echo
echo "Data:"
echo "  /var/lib/sarabis/"
echo
echo "Logs:"
echo "  /var/lib/sarabis/logs/sarabis.log"
echo

exit 0

# ============================================================
# PREUN
# ============================================================

%preun

if [ "$1" -eq 0 ]; then

    if command -v systemctl >/dev/null 2>&1; then

        systemctl disable --now sarabis.service \
            >/dev/null 2>&1 \
            || true

    fi

fi

exit 0

# ============================================================
# POSTUN
# ============================================================

%postun

if [ "$1" -eq 0 ]; then

    if command -v systemctl >/dev/null 2>&1; then

        systemctl daemon-reload \
            >/dev/null 2>&1 \
            || true

    fi

fi

exit 0

# ============================================================
# FILES
# ============================================================

%files

%defattr(-,root,root,-)

%attr(0755,root,root) %{_bindir}/sarabis

%dir %{_datadir}/sarabis
%dir %{_datadir}/sarabis/app

%{_datadir}/sarabis/app/*

@FILES_REQUIREMENTS@

@FILES_SETUP@

%config(noreplace) %{_sysconfdir}/sarabis/settings.py

%dir %{_localstatedir}/lib/sarabis
%dir %{_localstatedir}/lib/sarabis/uploads
%dir %{_localstatedir}/lib/sarabis/reports
%dir %{_localstatedir}/lib/sarabis/logs

%{_datadir}/applications/sarabis.desktop

%{_unitdir}/sarabis.service

%doc %{_docdir}/sarabis/README.SUSE

@FILES_README@

@FILES_LICENSE@

%doc %{_docdir}/sarabis/COPYING

# ============================================================
# CHANGELOG
# ============================================================

%changelog

* Thu Sep 24 2026 KYGnus <kygnus.co@proton.me> - @VERSION@-@RELEASE@
- Initial RPM package for sarabis Security Analyzer
SPECEOF

# ============================================================
# Build conditional SPEC fragments
#
# These are generated by Bash, NOT RPM %if conditions.
# This avoids the openSUSE "bare words are no longer supported"
# problem.
# ============================================================

if [ "${HAS_REQUIREMENTS}" -eq 1 ]; then

    INSTALL_REQUIREMENTS='
cp \
    requirements.txt \
    %{buildroot}%{_datadir}/sarabis/requirements.txt'

    FILES_REQUIREMENTS='%{_datadir}/sarabis/requirements.txt'

else

    INSTALL_REQUIREMENTS=':'

    FILES_REQUIREMENTS=''

fi

if [ "${HAS_SETUP}" -eq 1 ]; then

    INSTALL_SETUP='
cp \
    setup.py \
    %{buildroot}%{_datadir}/sarabis/setup.py'

    FILES_SETUP='%{_datadir}/sarabis/setup.py'

else

    INSTALL_SETUP=':'

    FILES_SETUP=''

fi

if [ "${HAS_README}" -eq 1 ]; then

    INSTALL_README='
cp \
    usr/share/doc/packages/sarabis/README.md \
    %{buildroot}%{_docdir}/sarabis/README.md'

    FILES_README='%doc %{_docdir}/sarabis/README.md'

else

    INSTALL_README=':'

    FILES_README=''

fi

if [ "${HAS_LICENSE}" -eq 1 ]; then

    INSTALL_LICENSE='
cp \
    usr/share/doc/packages/sarabis/LICENSE \
    %{buildroot}%{_docdir}/sarabis/LICENSE'

    FILES_LICENSE='%doc %{_docdir}/sarabis/LICENSE'

else

    INSTALL_LICENSE=':'

    FILES_LICENSE=''

fi

# ============================================================
# Replace placeholders
# ============================================================

sed -i \
    -e "s|@APP_NAME@|${APP_NAME}|g" \
    -e "s|@VERSION@|${VERSION}|g" \
    -e "s|@RELEASE@|${RELEASE}|g" \
    -e "s|@DESCRIPTION@|${DESCRIPTION}|g" \
    -e "s|@APP_URL@|${APP_URL}|g" \
    -e "s|@PROJECT_URL@|${PROJECT_URL}|g" \
    -e "/@INSTALL_REQUIREMENTS@/{
        r /dev/stdin
        d
    }" \
    "${SPEC_FILE}" <<EOF
${INSTALL_REQUIREMENTS}
EOF

# The previous sed method is intentionally not used for the
# remaining multiline fragments. Use a temporary replacement
# script instead.

python3 - "${SPEC_FILE}" \
    "${INSTALL_SETUP}" \
    "${INSTALL_README}" \
    "${INSTALL_LICENSE}" \
    "${FILES_REQUIREMENTS}" \
    "${FILES_SETUP}" \
    "${FILES_README}" \
    "${FILES_LICENSE}" <<'PY'
import sys

spec_file = sys.argv[1]

replacements = {
    "@INSTALL_SETUP@": sys.argv[2],
    "@INSTALL_README@": sys.argv[3],
    "@INSTALL_LICENSE@": sys.argv[4],
    "@FILES_REQUIREMENTS@": sys.argv[5],
    "@FILES_SETUP@": sys.argv[6],
    "@FILES_README@": sys.argv[7],
    "@FILES_LICENSE@": sys.argv[8],
}

with open(spec_file, "r", encoding="utf-8") as f:
    data = f.read()

for key, value in replacements.items():
    data = data.replace(key, value)

with open(spec_file, "w", encoding="utf-8") as f:
    f.write(data)
PY

# ============================================================
# Replace INSTALL_REQUIREMENTS safely
# ============================================================

python3 - "${SPEC_FILE}" "${INSTALL_REQUIREMENTS}" <<'PY'
import sys

spec_file = sys.argv[1]
replacement = sys.argv[2]

with open(spec_file, "r", encoding="utf-8") as f:
    data = f.read()

data = data.replace("@INSTALL_REQUIREMENTS@", replacement)

with open(spec_file, "w", encoding="utf-8") as f:
    f.write(data)
PY

# ============================================================
# Verify no placeholders remain
# ============================================================

if grep -q '@[A-Z_]*@' "${SPEC_FILE}"; then

    echo
    echo "❌ Unresolved SPEC placeholders:"
    grep -n '@[A-Z_]*@' "${SPEC_FILE}" || true
    echo

    die "SPEC generation failed."

fi

# ============================================================
# Verify no unsupported exists macro
# ============================================================

if grep -q '%if.*exists:' "${SPEC_FILE}"; then

    die "Unsupported RPM exists conditional remains in SPEC."

fi

# ============================================================
# Verify no old broken path
# ============================================================

if grep -q "cp -a app/\*" "${SPEC_FILE}"; then

    die "Old broken app/* copy command remains."

fi

echo
echo "✅ SPEC generated successfully."

# ============================================================
# Show important SPEC section
# ============================================================

echo
echo "============================================================"
echo "SPEC %install"
echo "============================================================"

awk '
/^%install$/ {show=1}
show {print}
' "${SPEC_FILE}" |
    sed -n '1,100p'

# ============================================================
# Build RPM
# ============================================================

echo
echo "📦 Building RPM package..."

rpmbuild \
    --define "_topdir ${RPM_TOPDIR}" \
    --define "_builddir ${BUILD_DIR_RPM}" \
    --define "_buildrootdir ${BUILDROOT_DIR}" \
    --define "_rpmdir ${RPMS_DIR}" \
    --define "_srcrpmdir ${SRPMS_DIR}" \
    --define "_sourcedir ${SOURCES_DIR}" \
    --define "_specdir ${SPECS_DIR}" \
    --define "_tmppath ${TMP_DIR}" \
    --define "debug_package %{nil}" \
    -bb \
    "${SPEC_FILE}"

echo
echo "✅ rpmbuild completed."

# ============================================================
# Locate RPM
# ============================================================

echo
echo "🔍 Locating generated RPM..."

BUILT_RPM=""

while IFS= read -r RPM_FILE; do

    [ -f "${RPM_FILE}" ] || continue

    RPM_NAME="$(
        rpm -qp \
            --qf '%{NAME}' \
            "${RPM_FILE}" \
            2>/dev/null || true
    )"

    RPM_VERSION="$(
        rpm -qp \
            --qf '%{VERSION}' \
            "${RPM_FILE}" \
            2>/dev/null || true
    )"

    RPM_ARCH="$(
        rpm -qp \
            --qf '%{ARCH}' \
            "${RPM_FILE}" \
            2>/dev/null || true
    )"

    if [ "${RPM_NAME}" = "${APP_NAME}" ] &&
       [ "${RPM_VERSION}" = "${VERSION}" ] &&
       [ "${RPM_ARCH}" = "${ARCHITECTURE}" ]; then

        BUILT_RPM="${RPM_FILE}"

        break

    fi

done < <(
    find "${RPMS_DIR}" \
        -type f \
        -name "*.rpm" \
        -print \
        | sort
)

if [ -z "${BUILT_RPM}" ]; then

    echo
    echo "❌ sarabis RPM was not found."
    echo
    echo "Generated packages:"
    echo

    find "${RPMS_DIR}" \
        -type f \
        -name "*.rpm" \
        -print \
        | sort || true

    exit 1

fi

echo
echo "✅ RPM found:"
echo
echo "   ${BUILT_RPM}"

# ============================================================
# Metadata
# ============================================================

echo
echo "🔍 RPM metadata..."

rpm -qpi "${BUILT_RPM}"

# ============================================================
# Validate metadata
# ============================================================

CHECK_NAME="$(
    rpm -qp \
        --qf '%{NAME}' \
        "${BUILT_RPM}"
)"

CHECK_VERSION="$(
    rpm -qp \
        --qf '%{VERSION}' \
        "${BUILT_RPM}"
)"

CHECK_ARCH="$(
    rpm -qp \
        --qf '%{ARCH}' \
        "${BUILT_RPM}"
)"

if [ "${CHECK_NAME}" != "${APP_NAME}" ]; then
    die "Incorrect package name: ${CHECK_NAME}"
fi

if [ "${CHECK_VERSION}" != "${VERSION}" ]; then
    die "Incorrect version: ${CHECK_VERSION}"
fi

if [ "${CHECK_ARCH}" != "${ARCHITECTURE}" ]; then
    die "Incorrect architecture: ${CHECK_ARCH}"
fi

echo
echo "✅ RPM metadata verified."

# ============================================================
# Verify package files
# ============================================================

echo
echo "🔍 Verifying package contents..."

RPM_CONTENTS="$(
    rpm -qpl "${BUILT_RPM}"
)"

check_package_file()
{
    local FILE="$1"

    if grep -Fxq "${FILE}" <<< "${RPM_CONTENTS}"; then

        echo "✅ ${FILE}"

    else

        echo "❌ ${FILE}"

        return 1

    fi
}

check_package_file "/usr/bin/sarabis"
check_package_file "/usr/share/sarabis/app/main.py"
check_package_file "/etc/sarabis/settings.py"
check_package_file "/usr/share/applications/sarabis.desktop"
check_package_file "/usr/lib/systemd/system/sarabis.service"

if [ "${HAS_REQUIREMENTS}" -eq 1 ]; then

    check_package_file "/usr/share/sarabis/requirements.txt"

fi

if [ "${HAS_SETUP}" -eq 1 ]; then

    check_package_file "/usr/share/sarabis/setup.py"

fi

# ============================================================
# Copy final RPM
# ============================================================

echo
echo "📦 Copying final RPM..."

rm -f "${FINAL_RPM}"

cp \
    "${BUILT_RPM}" \
    "${FINAL_RPM}"

chmod 644 "${FINAL_RPM}"

# ============================================================
# Final
# ============================================================

echo
echo "============================================================"
echo "                 BUILD SUCCESSFUL"
echo "============================================================"
echo
echo "RPM:"
echo
echo "  ${FINAL_RPM}"
echo
echo "Install:"
echo
echo "  sudo zypper install ./${FINAL_RPM}"
echo
echo "Run:"
echo
echo "  sarabis"
echo
echo "Web:"
echo
echo "  ${APP_URL}"
echo
echo "Query:"
echo
echo "  rpm -q sarabis"
echo
echo "Files:"
echo
echo "  rpm -ql sarabis"
echo
echo "============================================================"
