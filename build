#!/bin/bash

# build_deb.sh - One-step script to create a .deb package for Hermes Security Analyzer

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}🚀 Building .deb package for Hermes Security Analyzer${NC}"

# Configuration
APP_NAME="hermes"
VERSION="1.0.0"
MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="Hermes Security Analyzer - Comprehensive remote Linux system security analysis platform"
ARCHITECTURE="all"
DEB_DIR="deb_package"
DEB_ROOT="${DEB_DIR}/${APP_NAME}_${VERSION}_${ARCHITECTURE}"

# Clean previous builds
echo -e "${YELLOW}🧹 Cleaning previous builds...${NC}"
rm -rf ${DEB_DIR}
rm -f ${APP_NAME}_*.deb

# Create package structure
echo -e "${YELLOW}📁 Creating package structure...${NC}"
mkdir -p ${DEB_ROOT}/DEBIAN
mkdir -p ${DEB_ROOT}/usr/share/${APP_NAME}
mkdir -p ${DEB_ROOT}/usr/bin
mkdir -p ${DEB_ROOT}/usr/share/applications
mkdir -p ${DEB_ROOT}/usr/share/doc/${APP_NAME}
mkdir -p ${DEB_ROOT}/etc/${APP_NAME}
mkdir -p ${DEB_ROOT}/var/log/${APP_NAME}
mkdir -p ${DEB_ROOT}/var/lib/${APP_NAME}/uploads
mkdir -p ${DEB_ROOT}/var/lib/${APP_NAME}/reports

# Create control file with dependencies
echo -e "${YELLOW}📝 Creating control file...${NC}"
cat > ${DEB_ROOT}/DEBIAN/control << EOF
Package: ${APP_NAME}
Version: ${VERSION}
Section: utils
Priority: optional
Architecture: ${ARCHITECTURE}
Maintainer: ${MAINTAINER}
Description: ${DESCRIPTION}
Depends: python3 (>= 3.9), python3-pip, python3-venv, python3-dev, gcc, g++, ssh, openssh-client
Homepage: https://github.com/KooshaYeganeh/Hermes
EOF

# Create pre-installation script
cat > ${DEB_ROOT}/DEBIAN/preinst << 'EOF'
#!/bin/bash
set -e

echo "🔧 Preparing to install Hermes Security Analyzer..."

# Check if Python 3.9+ is installed
if ! command -v python3 &> /dev/null; then
    echo "❌ Python 3 is required but not installed."
    echo "Please install it with: sudo apt-get install python3 python3-pip python3-venv"
    exit 1
fi

# Check Python version
PYTHON_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
if [[ $(echo "$PYTHON_VERSION < 3.9" | bc) -eq 1 ]]; then
    echo "❌ Python 3.9+ is required (found $PYTHON_VERSION)"
    echo "Please upgrade Python or install from source."
    exit 1
fi

# Check for SSH client
if ! command -v ssh &> /dev/null; then
    echo "⚠️  SSH client not found. Installing openssh-client..."
    apt-get update && apt-get install -y openssh-client
fi

# Create necessary directories
mkdir -p /usr/share/hermes
mkdir -p /var/log/hermes
mkdir -p /var/lib/hermes/uploads
mkdir -p /var/lib/hermes/reports

echo "✅ Pre-installation checks passed"
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/preinst

# Create post-installation script
cat > ${DEB_ROOT}/DEBIAN/postinst << 'EOF'
#!/bin/bash
set -e

echo "🔧 Setting up Hermes Security Analyzer..."

APP_DIR="/usr/share/hermes"

# Create necessary directories
mkdir -p /var/log/hermes
mkdir -p /var/lib/hermes/uploads
mkdir -p /var/lib/hermes/reports

# Check if Python 3.9+ is available
if ! command -v python3 &> /dev/null; then
    echo "❌ Python 3 is not installed. Please install it first."
    exit 1
fi

# Ensure pip is available
if ! command -v pip3 &> /dev/null; then
    echo "📦 Installing pip3..."
    apt-get update && apt-get install -y python3-pip python3-venv python3-dev
fi

# Change to app directory
cd /usr/share/hermes

# Remove existing virtual environment if it exists
rm -rf venv

# Create virtual environment
echo "🐍 Creating Python virtual environment..."
python3 -m venv venv

# Activate virtual environment and install packages
echo "📦 Installing Python packages..."
source venv/bin/activate

# Upgrade pip
pip install --upgrade pip

# Install Python dependencies from requirements.txt
if [ -f "requirements.txt" ]; then
    echo "📦 Installing from requirements.txt..."
    pip install -r requirements.txt
else
    echo "⚠️  requirements.txt not found! Installing common packages..."
    pip install flask==2.3.2 paramiko==3.3.1 pandas numpy scikit-learn joblib gunicorn werkzeug flask-session cryptography bcrypt
fi

# Verify installations
echo "✅ Verifying installations..."
python -c "import flask, paramiko, pandas, numpy, sklearn, joblib, cryptography, bcrypt" || {
    echo "⚠️  Some packages failed to install. Trying alternative installation..."
    pip install flask paramiko pandas numpy scikit-learn joblib cryptography bcrypt --no-cache-dir
}

deactivate

# Create settings.py template if it doesn't exist
if [ ! -f "/etc/hermes/settings.py" ]; then
    echo "📝 Creating default configuration..."
    cat > /etc/hermes/settings.py << 'SETTINGS'
# Hermes Security Analyzer - Configuration File

import os

# SSH Configuration
SSH_HOST = "192.168.1.100"  # Target server IP (change this)
SSH_PORT = 22
SSH_USERNAME = "your_username"  # Change this
SSH_PASSWORD = "your_password"  # Or use SSH_KEY
SSH_KEY = None  # Set to private key path if using key auth

# Session Configuration
SESSION_TYPE = 'filesystem'
SESSION_PERMANENT = False
PERMANENT_SESSION_LIFETIME = 3600

# Paths
LOG_DIR = '/var/log/hermes'
REPORT_DIR = os.path.join(LOG_DIR, 'reports')

# Cache Settings
CACHE_TTL = 300
CACHE_MAX_SIZE = 100

# Security Settings
SECRET_KEY = 'change-this-secret-key-in-production'
PASSWORD_HASH = 'bcrypt'
SETTINGS

    echo "ℹ️  Default configuration created at /etc/hermes/settings.py"
    echo "   Please edit this file with your SSH credentials!"
fi

# Create launcher script
cat > /usr/bin/hermes << 'LAUNCHER'
#!/bin/bash
cd /usr/share/hermes
export PYTHONPATH=/usr/share/hermes
source venv/bin/activate
export FLASK_APP=main.py
export FLASK_ENV=production
export HERMES_CONFIG=/etc/hermes/settings.py
exec python main.py "$@"
LAUNCHER

chmod 755 /usr/bin/hermes

# Create systemd service file
cat > /etc/systemd/system/hermes.service << 'SERVICE'
[Unit]
Description=Hermes Security Analyzer Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/share/hermes
Environment="PATH=/usr/share/hermes/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=main.py"
Environment="FLASK_ENV=production"
Environment="HERMES_CONFIG=/etc/hermes/settings.py"
Environment="PYTHONPATH=/usr/share/hermes"
ExecStart=/usr/share/hermes/venv/bin/python /usr/share/hermes/main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/hermes/access.log
StandardError=append:/var/log/hermes/error.log

[Install]
WantedBy=multi-user.target
SERVICE

# Reload systemd
systemctl daemon-reload

# Set permissions
chown -R root:root /usr/share/hermes
chmod 755 /usr/share/hermes
chmod -R 755 /usr/share/hermes/app 2>/dev/null || true
chmod 755 /var/log/hermes
chmod 755 /var/lib/hermes/uploads
chmod 755 /var/lib/hermes/reports
chmod 644 /etc/hermes/settings.py

# Create default admin user if using authentication
echo "🔐 Setting up default admin credentials..."
cat > /usr/share/hermes/.admin_credentials << 'CRED'
Username: admin
Password: admin
⚠️  CHANGE THESE CREDENTIALS IMMEDIATELY!
CRED

echo ""
echo "✅ Installation complete!"
echo ""
echo "📋 To run the app directly:"
echo "  hermes"
echo ""
echo "🔗 Or use systemd service:"
echo "  sudo systemctl start hermes"
echo "  sudo systemctl enable hermes  # to start on boot"
echo ""
echo "🌐 The application will be available at: http://localhost:5050"
echo ""
echo "🔐 Default credentials:"
echo "  Username: admin"
echo "  Password: admin"
echo "  ⚠️  CHANGE THESE IMMEDIATELY!"
echo ""
echo "📝 Logs are stored in: /var/log/hermes/"
echo "📊 Reports are stored in: /var/lib/hermes/reports/"
echo "⚙️  Configuration: /etc/hermes/settings.py"
echo ""
echo "📦 To check service status:"
echo "  sudo systemctl status hermes"
echo ""
echo "🔍 For security best practices, please review the README.md"
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/postinst

# Create post-removal script
cat > ${DEB_ROOT}/DEBIAN/postrm << 'EOF'
#!/bin/bash
set -e

echo "🧹 Removing Hermes Security Analyzer..."

# Stop service if running
systemctl stop hermes 2>/dev/null || true
systemctl disable hermes 2>/dev/null || true

# Remove systemd service
rm -f /etc/systemd/system/hermes.service
systemctl daemon-reload 2>/dev/null || true

# Remove launcher
rm -f /usr/bin/hermes

# Ask about removing data
read -p "Remove application data and virtual environment? (y/N): " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    rm -rf /usr/share/hermes
    rm -rf /var/log/hermes
    rm -rf /var/lib/hermes
    rm -rf /etc/hermes
    echo "✅ Data removed"
else
    echo "ℹ️ Data preserved in /usr/share/hermes"
fi
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/postrm

# Copy application files
echo -e "${YELLOW}📦 Copying application files...${NC}"

# Copy main application files
cp -r app ${DEB_ROOT}/usr/share/${APP_NAME}/ 2>/dev/null || {
    echo "⚠️  app directory not found, copying all Python files..."
    # Copy all Python files if no app directory
    find . -maxdepth 1 -name "*.py" -exec cp {} ${DEB_ROOT}/usr/share/${APP_NAME}/ \;
}

# Copy main.py if it exists
if [ -f "main.py" ]; then
    cp main.py ${DEB_ROOT}/usr/share/${APP_NAME}/
fi

# Copy requirements.txt
if [ -f "requirements.txt" ]; then
    cp requirements.txt ${DEB_ROOT}/usr/share/${APP_NAME}/
fi

# Create app directory structure if it doesn't exist
if [ ! -d "${DEB_ROOT}/usr/share/${APP_NAME}/app" ]; then
    mkdir -p ${DEB_ROOT}/usr/share/${APP_NAME}/app
    # Move any Python files to app directory
    find ${DEB_ROOT}/usr/share/${APP_NAME} -maxdepth 1 -name "*.py" -not -name "main.py" -exec mv {} ${DEB_ROOT}/usr/share/${APP_NAME}/app/ \;
fi

# Create __init__.py in app directory if missing
if [ ! -f ${DEB_ROOT}/usr/share/${APP_NAME}/app/__init__.py ]; then
    touch ${DEB_ROOT}/usr/share/${APP_NAME}/app/__init__.py
fi

# Create README with Hermes information
cat > ${DEB_ROOT}/usr/share/doc/${APP_NAME}/README << 'EOF'
Hermes Security Analyzer
=========================

A Comprehensive Remote System Security Analysis Platform

Overview
--------
Hermes Security Analyzer is a powerful Flask-based web application designed 
for comprehensive remote Linux system security analysis. It performs deep 
security assessments without making any modifications to the target systems.

Key Features
------------
- 🔍 Vulnerability Scanning: CVE detection using NVD database
- 🌐 Port Analysis: Comprehensive port scanning with risk scoring
- ⚙️ Service Analysis: Deep inspection of system services
- 🧩 Process Analysis: Real-time process monitoring with anomaly detection
- 🧠 Kernel Module Analysis: Rootkit detection and integrity verification
- 📦 Software Audit: Package analysis with threat intelligence
- 👤 User Analysis: Privilege audit and suspicious account detection
- 🛡️ Hardening Checks: Comprehensive security posture assessment

Quick Start
-----------
1. Edit configuration:
   sudo nano /etc/hermes/settings.py
   (Update SSH credentials for your target systems)

2. Run the application:
   $ hermes

3. Or use systemd:
   $ sudo systemctl start hermes
   $ sudo systemctl enable hermes  # to start on boot

4. Open browser and navigate to:
   http://localhost:5050

Default Credentials:
   Username: admin
   Password: admin
   ⚠️  CHANGE THESE IMMEDIATELY!

Directory Structure
-------------------
/usr/share/hermes/        - Application files
/var/log/hermes/          - Log files
/var/lib/hermes/reports/  - Generated reports
/etc/hermes/              - Configuration files

Requirements
------------
- Python 3.9+
- SSH client
- Target Linux servers with SSH access

Uninstall
---------
$ sudo dpkg -r hermes

For more information, visit:
https://github.com/KooshaYeganeh/Hermes

License: GPL-3.0
EOF

# Create a simple start script as fallback
cat > ${DEB_ROOT}/usr/share/${APP_NAME}/run.sh << 'EOF'
#!/bin/bash
cd /usr/share/hermes
source venv/bin/activate
export FLASK_APP=main.py
export FLASK_ENV=production
export HERMES_CONFIG=/etc/hermes/settings.py
python main.py
EOF

chmod 755 ${DEB_ROOT}/usr/share/${APP_NAME}/run.sh

# Create desktop entry
cat > ${DEB_ROOT}/usr/share/applications/hermes.desktop << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Hermes Security Analyzer
Comment=Comprehensive remote Linux system security analysis platform
Exec=hermes
Icon=hermes
Terminal=false
Categories=Network;Security;System;
Keywords=security;analysis;audit;ssh
EOF

# Set proper permissions
echo -e "${YELLOW}🔧 Setting permissions...${NC}"
find ${DEB_ROOT} -type d -exec chmod 755 {} \;
find ${DEB_ROOT} -name "*.py" -exec chmod 644 {} \;
find ${DEB_ROOT} -name "*.sh" -exec chmod 755 {} \;

# Build the .deb package
echo -e "${YELLOW}🔨 Building .deb package...${NC}"
cd ${DEB_DIR}
dpkg-deb --build ${APP_NAME}_${VERSION}_${ARCHITECTURE}
cd ..

# Move the .deb to root directory
mv ${DEB_DIR}/${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb .

# Clean up
echo -e "${YELLOW}🧹 Cleaning up build directory...${NC}"
rm -rf ${DEB_DIR}

echo -e "${GREEN}✅ Successfully created: ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb${NC}"
echo -e "${GREEN}📦 Package size: $(du -h ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb | cut -f1)${NC}"
echo ""
echo -e "${GREEN}To install the package:${NC}"
echo "  sudo dpkg -i ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb"
echo ""
echo -e "${GREEN}If you get dependency errors, fix with:${NC}"
echo "  sudo apt-get install -f"
echo ""
echo -e "${GREEN}After installation:${NC}"
echo "  1. Edit /etc/hermes/settings.py with your SSH credentials"
echo "  2. Start the service: sudo systemctl start hermes"
echo "  3. Access at: http://localhost:5050"
echo "  4. Login with: admin/admin (CHANGE IMMEDIATELY!)"
echo ""
echo -e "${GREEN}The package will automatically install all Python dependencies via pip.${NC}"
echo -e "${GREEN}For more information, see the README at /usr/share/doc/hermes/README${NC}"
