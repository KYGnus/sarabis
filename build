#!/bin/bash

set -e

# ============================================================
# sarabis Security Analyzer - Debian Package Builder
# ============================================================

APP_NAME="sarabis"
VERSION="1.1.0"
ARCHITECTURE="all"

MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="sarabis Security Analyzer - Comprehensive remote Linux system security analysis platform"

APP_URL="http://localhost:8080"

DEB_DIR="deb_package"
DEB_ROOT="${DEB_DIR}/${APP_NAME}_${VERSION}_${ARCHITECTURE}"

APP_INSTALL_DIR="/usr/share/${APP_NAME}"
CONFIG_DIR="/etc/${APP_NAME}"

# Application data and runtime files.
# These are intentionally stored under /var/lib because
# sarabis is launched by the normal desktop user on antiX.
DATA_DIR="/var/lib/${APP_NAME}"
UPLOAD_DIR="${DATA_DIR}/uploads"
REPORT_DIR="${DATA_DIR}/reports"
LOG_DIR="${DATA_DIR}/logs"

BIN_DIR="/usr/bin"
BIN_FILE="${BIN_DIR}/${APP_NAME}"

DESKTOP_DIR="/usr/share/applications"
DESKTOP_FILE="${DESKTOP_DIR}/${APP_NAME}.desktop"

DOC_DIR="/usr/share/doc/${APP_NAME}"

PACKAGE_FILE="${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb"

echo
echo "============================================================"
echo "       ${APP_NAME} Security Analyzer .deb Builder"
echo "============================================================"
echo
echo "Package:      ${APP_NAME}"
echo "Version:      ${VERSION}"
echo "Architecture: ${ARCHITECTURE}"
echo "URL:          ${APP_URL}"
echo

# ============================================================
# Build requirements
# ============================================================

echo "🔍 Checking build requirements..."

if ! command -v dpkg-deb >/dev/null 2>&1; then
    echo "❌ dpkg-deb is not installed."
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "❌ python3 is not installed."
    exit 1
fi

echo "✅ Build requirements OK"
echo

# ============================================================
# Clean previous build
# ============================================================

echo "🧹 Cleaning previous builds..."

rm -rf "${DEB_DIR}"
rm -f "${PACKAGE_FILE}"
rm -f "${APP_NAME}"_*.deb

mkdir -p "${DEB_ROOT}"

echo

# ============================================================
# Check application source
# ============================================================

echo "🔍 Checking application source..."

if [ ! -f "app/main.py" ]; then
    echo "❌ app/main.py not found."
    echo "Run this script from the sarabis project directory."
    exit 1
fi

echo "✅ app/main.py found"
echo

# ============================================================
# Create Debian package structure
# ============================================================

echo "📁 Creating Debian package structure..."

mkdir -p "${DEB_ROOT}/DEBIAN"

mkdir -p "${DEB_ROOT}${APP_INSTALL_DIR}/app"

mkdir -p "${DEB_ROOT}${BIN_DIR}"
mkdir -p "${DEB_ROOT}${DESKTOP_DIR}"
mkdir -p "${DEB_ROOT}${DOC_DIR}"

mkdir -p "${DEB_ROOT}${CONFIG_DIR}"

mkdir -p "${DEB_ROOT}${DATA_DIR}"
mkdir -p "${DEB_ROOT}${UPLOAD_DIR}"
mkdir -p "${DEB_ROOT}${REPORT_DIR}"
mkdir -p "${DEB_ROOT}${LOG_DIR}"

echo

# ============================================================
# DEBIAN/control
# ============================================================

echo "📝 Creating DEBIAN/control..."

cat > "${DEB_ROOT}/DEBIAN/control" <<EOF
Package: ${APP_NAME}
Version: ${VERSION}
Section: security
Priority: optional
Architecture: ${ARCHITECTURE}
Maintainer: ${MAINTAINER}
Depends: python3, python3-pip, python3-venv, python3-dev, gcc, g++, openssh-client, curl, xdg-utils
Description: ${DESCRIPTION}
 sarabis is a comprehensive Linux security analysis platform.
 It provides remote Linux system security analysis, reporting,
 SSH-based auditing and security assessment capabilities.
EOF

echo

# ============================================================
# DEBIAN/preinst
# ============================================================

echo "📝 Creating preinst script..."

cat > "${DEB_ROOT}/DEBIAN/preinst" <<'EOF'
#!/bin/bash

set -e

APP_NAME="sarabis"

echo
echo "Preparing ${APP_NAME} installation..."

# ------------------------------------------------------------
# Python check
# ------------------------------------------------------------

if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required."
    exit 1
fi

# ------------------------------------------------------------
# Create required directories
# ------------------------------------------------------------

mkdir -p /etc/sarabis

mkdir -p /var/lib/sarabis
mkdir -p /var/lib/sarabis/uploads
mkdir -p /var/lib/sarabis/reports
mkdir -p /var/lib/sarabis/logs

exit 0
EOF

chmod 755 "${DEB_ROOT}/DEBIAN/preinst"

echo

# ============================================================
# DEBIAN/postinst
# ============================================================

echo "📝 Creating postinst script..."

cat > "${DEB_ROOT}/DEBIAN/postinst" <<'EOF'
#!/bin/bash

set -e

APP_NAME="sarabis"

APP_DIR="/usr/share/sarabis"
BIN_FILE="/usr/bin/sarabis"

CONFIG_DIR="/etc/sarabis"

DATA_DIR="/var/lib/sarabis"
UPLOAD_DIR="/var/lib/sarabis/uploads"
REPORT_DIR="/var/lib/sarabis/reports"
LOG_DIR="/var/lib/sarabis/logs"

echo
echo "============================================================"
echo " Configuring sarabis Security Analyzer"
echo "============================================================"
echo

# ============================================================
# Create directories
# ============================================================

echo "📁 Creating application directories..."

mkdir -p "$CONFIG_DIR"

mkdir -p "$DATA_DIR"
mkdir -p "$UPLOAD_DIR"
mkdir -p "$REPORT_DIR"
mkdir -p "$LOG_DIR"

# ============================================================
# Determine installing desktop user
#
# When installed with:
#
#     sudo apt install ./sarabis.deb
#
# SUDO_USER normally contains the real desktop user.
# ============================================================

INSTALL_USER=""

if [ -n "${SUDO_USER:-}" ] && id "$SUDO_USER" >/dev/null 2>&1; then
    INSTALL_USER="$SUDO_USER"
fi

if [ -z "$INSTALL_USER" ]; then

    if [ -n "${PKEXEC_UID:-}" ]; then

        INSTALL_USER="$(id -nu "$PKEXEC_UID" 2>/dev/null || true)"

    fi

fi

# Fallback.
if [ -z "$INSTALL_USER" ]; then

    if [ -n "${USER:-}" ] && id "$USER" >/dev/null 2>&1; then
        INSTALL_USER="$USER"
    fi

fi

# ============================================================
# Create Python virtual environment
# ============================================================

if [ ! -d "$APP_DIR/venv" ]; then

    echo "🐍 Creating Python virtual environment..."

    python3 -m venv "$APP_DIR/venv"

fi

# ============================================================
# Install Python dependencies
# ============================================================

if [ -f "$APP_DIR/requirements.txt" ]; then

    echo
    echo "📦 Installing Python dependencies..."

    "$APP_DIR/venv/bin/python" -m pip install \
        --disable-pip-version-check \
        --no-input \
        -r "$APP_DIR/requirements.txt" || {

        echo
        echo "⚠️ Warning:"
        echo "Some Python dependencies could not be installed."
        echo "The Debian package installation will continue."
        echo

    }

fi

# ============================================================
# Create settings.py
# ============================================================

if [ ! -f "$CONFIG_DIR/settings.py" ]; then

    echo
    echo "⚙️ Creating configuration..."

    cat > "$CONFIG_DIR/settings.py" <<'PYEOF'
# ============================================================
# sarabis Security Analyzer Configuration
# ============================================================

HOST = "127.0.0.1"
PORT = 8080

DEBUG = False

# ------------------------------------------------------------
# Application directories
# ------------------------------------------------------------

UPLOAD_DIR = "/var/lib/sarabis/uploads"
REPORT_DIR = "/var/lib/sarabis/reports"
LOG_DIR = "/var/lib/sarabis/logs"

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

SECRET_KEY = "sarabis-change-this-secret-key"

# ------------------------------------------------------------
# Default administrator
# ------------------------------------------------------------

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "admin"
PYEOF

fi

# ============================================================
# Admin credentials
# ============================================================

if [ ! -f "$APP_DIR/.admin_credentials" ]; then

    echo "🔐 Creating default admin credentials..."

    cat > "$APP_DIR/.admin_credentials" <<'EOF2'
username=admin
password=admin
EOF2

    chmod 600 "$APP_DIR/.admin_credentials"

fi

# ============================================================
# Create /usr/bin/sarabis
#
# IMPORTANT:
# The launcher is created both inside the package archive
# and here during postinst.
#
# This guarantees that the command exists after installation.
# ============================================================

echo
echo "🔧 Installing sarabis command..."

cat > "$BIN_FILE" <<'LAUNCHER'
#!/bin/bash

# ============================================================
# sarabis launcher
# ============================================================

APP_DIR="/usr/share/sarabis"
APP_URL="http://localhost:8080"

VENV_PYTHON="$APP_DIR/venv/bin/python"
MAIN_APP="$APP_DIR/app/main.py"

DATA_DIR="/var/lib/sarabis"
LOG_DIR="$DATA_DIR/logs"
LOG_FILE="$LOG_DIR/sarabis.log"

# ------------------------------------------------------------
# Create runtime log directory
# ------------------------------------------------------------

mkdir -p "$LOG_DIR" 2>/dev/null || true

# ------------------------------------------------------------
# Application verification
# ------------------------------------------------------------

if [ ! -f "$MAIN_APP" ]; then

    echo
    echo "❌ ERROR: sarabis application not found:"
    echo "   $MAIN_APP"
    echo

    exit 1
fi

if [ ! -x "$VENV_PYTHON" ]; then

    echo
    echo "❌ ERROR: Python virtual environment not found:"
    echo "   $VENV_PYTHON"
    echo

    echo "Try reinstalling the package:"
    echo "sudo apt install --reinstall ./sarabis_1.1.0_all.deb"
    echo

    exit 1
fi

# ------------------------------------------------------------
# Check whether sarabis is already running
# ------------------------------------------------------------

if command -v curl >/dev/null 2>&1; then

    if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

        echo "sarabis is already running."
        echo "🌐 Opening: $APP_URL"

        # ----------------------------------------------------
        # Open browser
        # ----------------------------------------------------

        if command -v xdg-open >/dev/null 2>&1; then

            xdg-open "$APP_URL" >/dev/null 2>&1 &

        elif command -v sensible-browser >/dev/null 2>&1; then

            sensible-browser "$APP_URL" >/dev/null 2>&1 &

        elif command -v firefox >/dev/null 2>&1; then

            firefox "$APP_URL" >/dev/null 2>&1 &

        elif command -v chromium >/dev/null 2>&1; then

            chromium "$APP_URL" >/dev/null 2>&1 &

        elif command -v chromium-browser >/dev/null 2>&1; then

            chromium-browser "$APP_URL" >/dev/null 2>&1 &

        else

            echo "⚠️ No supported browser found."
            echo "Open manually: $APP_URL"

        fi

        exit 0
    fi

fi

# ------------------------------------------------------------
# Make sure log directory is writable
# ------------------------------------------------------------

if ! touch "$LOG_FILE" >/dev/null 2>&1; then

    echo
    echo "⚠️ Warning: Cannot write to:"
    echo "   $LOG_FILE"
    echo
    echo "Trying to continue without file logging..."
    echo

    LOG_FILE="/tmp/sarabis-${USER:-user}.log"

    touch "$LOG_FILE" 2>/dev/null || true

fi

# ------------------------------------------------------------
# Start Flask application
# ------------------------------------------------------------

echo "🚀 Starting sarabis Security Analyzer..."
echo "🌐 URL: $APP_URL"

if [ -w "$(dirname "$LOG_FILE")" ] ] 2>/dev/null; then

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >> "$LOG_FILE" 2>&1 &

else

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >/dev/null 2>&1 &

fi

SARABIS_PID=$!

echo "sarabis started."
echo "PID: $SARABIS_PID"

# ------------------------------------------------------------
# Wait for web interface
# ------------------------------------------------------------

echo "⏳ Waiting for web interface..."

SERVER_READY=0

for i in $(seq 1 30); do

    sleep 1

    # Check whether process is still alive.
    if ! kill -0 "$SARABIS_PID" 2>/dev/null; then

        echo
        echo "❌ sarabis process exited unexpectedly."

        if [ -f "$LOG_FILE" ]; then

            echo
            echo "Last log output:"
            tail -n 30 "$LOG_FILE" 2>/dev/null || true

        fi

        exit 1
    fi

    if command -v curl >/dev/null 2>&1; then

        if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

            SERVER_READY=1
            break

        fi

    fi

done

# ------------------------------------------------------------
# Server status
# ------------------------------------------------------------

if [ "$SERVER_READY" -eq 1 ]; then

    echo "✅ sarabis web interface is ready."
    echo "🌐 $APP_URL"

else

    echo
    echo "⚠️ Web interface did not respond within 30 seconds."
    echo
    echo "Check:"
    echo "  $LOG_FILE"
    echo
    echo "The process may still be starting."
    echo

fi

# ------------------------------------------------------------
# Open browser
# ------------------------------------------------------------

if command -v xdg-open >/dev/null 2>&1; then

    xdg-open "$APP_URL" >/dev/null 2>&1 &

elif command -v sensible-browser >/dev/null 2>&1; then

    sensible-browser "$APP_URL" >/dev/null 2>&1 &

elif command -v firefox >/dev/null 2>&1; then

    firefox "$APP_URL" >/dev/null 2>&1 &

elif command -v chromium >/dev/null 2>&1; then

    chromium "$APP_URL" >/dev/null 2>&1 &

elif command -v chromium-browser >/dev/null 2>&1; then

    chromium-browser "$APP_URL" >/dev/null 2>&1 &

else

    echo "⚠️ No graphical browser found."
    echo "Open manually:"
    echo "  $APP_URL"

fi

exit 0
LAUNCHER

chmod 755 "$BIN_FILE"

echo "✅ /usr/bin/sarabis created."

# ============================================================
# Ownership and permissions
# ============================================================

echo
echo "🔧 Configuring permissions..."

chmod 755 "$APP_DIR"
chmod 755 "$APP_DIR/app"

find "$APP_DIR/app" \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \; 2>/dev/null || true

chmod 755 "$BIN_FILE"

# ------------------------------------------------------------
# Application data
# ------------------------------------------------------------

chmod 755 "$DATA_DIR"
chmod 755 "$UPLOAD_DIR"
chmod 755 "$REPORT_DIR"
chmod 755 "$LOG_DIR"

# ------------------------------------------------------------
# Give desktop user ownership of runtime data
#
# This is important because sarabis is launched as the normal
# user rather than as root on antiX.
# ------------------------------------------------------------

if [ -n "$INSTALL_USER" ] && id "$INSTALL_USER" >/dev/null 2>&1; then

    INSTALL_GROUP="$(id -gn "$INSTALL_USER")"

    echo "👤 Runtime user: $INSTALL_USER"
    echo "👥 Runtime group: $INSTALL_GROUP"

    chown "$INSTALL_USER:$INSTALL_GROUP" "$DATA_DIR"
    chown "$INSTALL_USER:$INSTALL_GROUP" "$UPLOAD_DIR"
    chown "$INSTALL_USER:$INSTALL_GROUP" "$REPORT_DIR"
    chown "$INSTALL_USER:$INSTALL_GROUP" "$LOG_DIR"

fi

# ------------------------------------------------------------
# Configuration remains root-owned.
# ------------------------------------------------------------

chown root:root "$CONFIG_DIR" 2>/dev/null || true

if [ -f "$CONFIG_DIR/settings.py" ]; then
    chmod 644 "$CONFIG_DIR/settings.py"
fi

# ============================================================
# Detect init system
# ============================================================

echo

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then

    echo "⚙️ systemd detected."

    cat > /etc/systemd/system/sarabis.service <<'SERVICEEOF'
[Unit]
Description=sarabis Security Analyzer
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/share/sarabis
ExecStart=/usr/share/sarabis/venv/bin/python /usr/share/sarabis/app/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICEEOF

    systemctl daemon-reload || true

    echo
    echo "Service installed:"
    echo "  systemctl start sarabis"
    echo "  systemctl enable sarabis"

else

    echo "ℹ️ antiX / SysVinit / non-systemd environment detected."
    echo "sarabis will run through:"
    echo "  /usr/bin/sarabis"

fi

# ============================================================
# Desktop database
# ============================================================

if command -v update-desktop-database >/dev/null 2>&1; then

    update-desktop-database \
        /usr/share/applications \
        >/dev/null 2>&1 || true

fi

# ============================================================
# Final launcher verification
# ============================================================

if [ ! -f "$BIN_FILE" ]; then

    echo
    echo "❌ ERROR: $BIN_FILE was not created."
    exit 1

fi

if [ ! -x "$BIN_FILE" ]; then

    echo
    echo "❌ ERROR: $BIN_FILE is not executable."
    exit 1

fi

# ============================================================
# Final installation summary
# ============================================================

echo
echo "============================================================"
echo " sarabis installation completed"
echo "============================================================"
echo
echo "Command:"
echo "  sarabis"
echo
echo "Web interface:"
echo "  http://localhost:8080"
echo
echo "Configuration:"
echo "  /etc/sarabis/settings.py"
echo
echo "Uploads:"
echo "  /var/lib/sarabis/uploads/"
echo
echo "Reports:"
echo "  /var/lib/sarabis/reports/"
echo
echo "Logs:"
echo "  /var/lib/sarabis/logs/"
echo
echo "Log file:"
echo "  /var/lib/sarabis/logs/sarabis.log"
echo
echo "Default credentials:"
echo "  Username: admin"
echo "  Password: admin"
echo
echo "Launcher:"
echo "  /usr/bin/sarabis"
echo

exit 0
EOF

chmod 755 "${DEB_ROOT}/DEBIAN/postinst"

echo

# ============================================================
# DEBIAN/postrm
# ============================================================

echo "📝 Creating postrm script..."

cat > "${DEB_ROOT}/DEBIAN/postrm" <<'EOF'
#!/bin/bash

set -e

APP_NAME="sarabis"

echo
echo "sarabis package lifecycle: ${1:-unknown}"

# ============================================================
# Stop systemd service if one exists
# ============================================================

if command -v systemctl >/dev/null 2>&1; then

    if [ -f /etc/systemd/system/sarabis.service ]; then

        systemctl stop sarabis.service 2>/dev/null || true
        systemctl disable sarabis.service 2>/dev/null || true

        rm -f /etc/systemd/system/sarabis.service

        systemctl daemon-reload 2>/dev/null || true

    fi

fi

# ============================================================
# IMPORTANT
#
# Do NOT manually remove /usr/bin/sarabis.
#
# It is a package-owned file and dpkg manages it.
#
# The previous version manually removed this file from postrm,
# which caused:
#
#   dpkg -L sarabis
#
# to report /usr/bin/sarabis while the actual file was missing.
# ============================================================

case "${1:-}" in

    remove)

        echo "sarabis removed."
        echo "Package-owned files are managed by dpkg."

        ;;

    purge)

        echo "Purging sarabis configuration..."

        rm -f /etc/systemd/system/sarabis.service

        # Runtime data is intentionally preserved.
        # Remove manually if required:
        #
        #   sudo rm -rf /var/lib/sarabis
        #

        ;;

    upgrade|abort-upgrade|failed-upgrade)

        echo "Upgrade operation detected."
        echo "sarabis launcher remains managed by dpkg."

        ;;

    *)

        echo "No destructive launcher cleanup performed."

        ;;

esac

exit 0
EOF

chmod 755 "${DEB_ROOT}/DEBIAN/postrm"

echo

# ============================================================
# Copy application
# ============================================================

echo "📦 Copying application files..."

cp -a app/. "${DEB_ROOT}${APP_INSTALL_DIR}/app/"

echo

# ============================================================
# requirements.txt
# ============================================================

echo "📦 Copying requirements.txt..."

if [ -f requirements.txt ]; then

    cp requirements.txt \
        "${DEB_ROOT}${APP_INSTALL_DIR}/requirements.txt"

    echo "  requirements.txt copied."

else

    echo "⚠️ requirements.txt not found."

fi

echo

# ============================================================
# Additional files
# ============================================================

echo "📄 Copying additional files..."

if [ -f setup.py ]; then

    echo "  Copying setup.py..."

    cp setup.py \
        "${DEB_ROOT}${APP_INSTALL_DIR}/setup.py"

fi

if [ -f LICENSE ]; then

    echo "  Copying LICENSE..."

    cp LICENSE \
        "${DEB_ROOT}${DOC_DIR}/LICENSE"

fi

if [ -f README.md ]; then

    echo "  Copying README.md..."

    cp README.md \
        "${DEB_ROOT}${DOC_DIR}/README.md"

fi

# ============================================================
# app/__init__.py
# ============================================================

echo

if [ ! -f "${DEB_ROOT}${APP_INSTALL_DIR}/app/__init__.py" ]; then

    echo "📄 Creating app/__init__.py..."

    touch "${DEB_ROOT}${APP_INSTALL_DIR}/app/__init__.py"

fi

# ============================================================
# Verify main.py
# ============================================================

echo

if [ -f "${DEB_ROOT}${APP_INSTALL_DIR}/app/main.py" ]; then

    echo "✅ main.py found:"
    echo "   ${DEB_ROOT}${APP_INSTALL_DIR}/app/main.py"

else

    echo "❌ main.py was not copied."

    exit 1

fi

echo

# ============================================================
# Create package launcher
#
# IMPORTANT:
# This must happen BEFORE chmod.
# ============================================================

echo "🖥️ Creating package launcher..."

cat > "${DEB_ROOT}${BIN_FILE}" <<'LAUNCHER'
#!/bin/bash

APP_DIR="/usr/share/sarabis"
APP_URL="http://localhost:8080"

VENV_PYTHON="$APP_DIR/venv/bin/python"
MAIN_APP="$APP_DIR/app/main.py"

DATA_DIR="/var/lib/sarabis"
LOG_DIR="$DATA_DIR/logs"
LOG_FILE="$LOG_DIR/sarabis.log"

mkdir -p "$LOG_DIR" 2>/dev/null || true

if [ ! -f "$MAIN_APP" ]; then

    echo "❌ ERROR: sarabis application not found:"
    echo "$MAIN_APP"

    exit 1

fi

if [ ! -x "$VENV_PYTHON" ]; then

    echo "❌ ERROR: Python virtual environment not found:"
    echo "$VENV_PYTHON"

    exit 1

fi

# ------------------------------------------------------------
# Already running?
# ------------------------------------------------------------

if command -v curl >/dev/null 2>&1; then

    if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

        echo "sarabis is already running."
        echo "🌐 Opening: $APP_URL"

        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$APP_URL" >/dev/null 2>&1 &
        elif command -v sensible-browser >/dev/null 2>&1; then
            sensible-browser "$APP_URL" >/dev/null 2>&1 &
        elif command -v firefox >/dev/null 2>&1; then
            firefox "$APP_URL" >/dev/null 2>&1 &
        elif command -v chromium >/dev/null 2>&1; then
            chromium "$APP_URL" >/dev/null 2>&1 &
        elif command -v chromium-browser >/dev/null 2>&1; then
            chromium-browser "$APP_URL" >/dev/null 2>&1 &
        fi

        exit 0

    fi

fi

# ------------------------------------------------------------
# Test log file
# ------------------------------------------------------------

if touch "$LOG_FILE" >/dev/null 2>&1; then

    LOG_ENABLED=1

else

    LOG_ENABLED=0

    LOG_FILE="/tmp/sarabis-${USER:-user}.log"

    touch "$LOG_FILE" >/dev/null 2>&1 || true

    echo "⚠️ Warning: unable to write to application log directory."
    echo "Using temporary log:"
    echo "$LOG_FILE"

fi

# ------------------------------------------------------------
# Start Flask
# ------------------------------------------------------------

echo "🚀 Starting sarabis Security Analyzer..."
echo "🌐 URL: $APP_URL"

if [ "$LOG_ENABLED" -eq 1 ]; then

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >> "$LOG_FILE" 2>&1 &

else

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >/dev/null 2>&1 &

fi

SARABIS_PID=$!

echo "sarabis started."
echo "PID: $SARABIS_PID"

# ------------------------------------------------------------
# Wait for server
# ------------------------------------------------------------

echo "⏳ Waiting for web interface..."

SERVER_READY=0

for i in $(seq 1 30); do

    sleep 1

    if ! kill -0 "$SARABIS_PID" 2>/dev/null; then

        echo
        echo "❌ sarabis process exited unexpectedly."

        if [ -f "$LOG_FILE" ]; then

            echo
            echo "Last log output:"
            tail -n 30 "$LOG_FILE" 2>/dev/null || true

        fi

        exit 1

    fi

    if command -v curl >/dev/null 2>&1; then

        if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

            SERVER_READY=1
            break

        fi

    fi

done

# ------------------------------------------------------------
# Status
# ------------------------------------------------------------

if [ "$SERVER_READY" -eq 1 ]; then

    echo "✅ sarabis web interface is ready."
    echo "🌐 $APP_URL"

else

    echo
    echo "⚠️ Web interface did not respond within 30 seconds."
    echo "Check:"
    echo "  $LOG_FILE"

fi

# ------------------------------------------------------------
# Open browser
# ------------------------------------------------------------

if command -v xdg-open >/dev/null 2>&1; then

    xdg-open "$APP_URL" >/dev/null 2>&1 &

elif command -v sensible-browser >/dev/null 2>&1; then

    sensible-browser "$APP_URL" >/dev/null 2>&1 &

elif command -v firefox >/dev/null 2>&1; then

    firefox "$APP_URL" >/dev/null 2>&1 &

elif command -v chromium >/dev/null 2>&1; then

    chromium "$APP_URL" >/dev/null 2>&1 &

elif command -v chromium-browser >/dev/null 2>&1; then

    chromium-browser "$APP_URL" >/dev/null 2>&1 &

else

    echo "⚠️ No graphical browser found."
    echo "Open manually:"
    echo "  $APP_URL"

fi

exit 0
LAUNCHER

chmod 755 "${DEB_ROOT}${BIN_FILE}"

echo "✅ Package launcher created:"
echo "   ${DEB_ROOT}${BIN_FILE}"

echo

# ============================================================
# Desktop launcher
# ============================================================

echo "🖥️ Creating desktop launcher..."

cat > "${DEB_ROOT}${DESKTOP_FILE}" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=sarabis Security Analyzer
GenericName=Security Analyzer
Comment=Comprehensive Linux Security Analysis Platform
Exec=/usr/bin/sarabis
TryExec=/usr/bin/sarabis
Icon=security
Terminal=false
StartupNotify=true
Categories=Network;Security;System;
Keywords=security;analysis;audit;ssh;scanning;linux;
EOF

echo

# ============================================================
# Documentation
# ============================================================

echo "📚 Creating documentation..."

cat > "${DEB_ROOT}${DOC_DIR}/README.Debian" <<'EOF'
sarabis Security Analyzer
=========================

Command:
    sarabis

Web interface:
    http://localhost:8080

Configuration:
    /etc/sarabis/settings.py

Application data:
    /var/lib/sarabis/

Uploads:
    /var/lib/sarabis/uploads/

Reports:
    /var/lib/sarabis/reports/

Logs:
    /var/lib/sarabis/logs/

Main log:
    /var/lib/sarabis/logs/sarabis.log

Default credentials:
    Username: admin
    Password: admin

antiX / SysVinit:
    sarabis runs through the /usr/bin/sarabis launcher.

systemd:
    A systemd service is installed when systemd is detected.
EOF

echo

# ============================================================
# Package permissions
# ============================================================

echo "🔧 Setting package permissions..."

chmod 755 "${DEB_ROOT}${BIN_FILE}"

chmod 755 "${DEB_ROOT}${APP_INSTALL_DIR}"
chmod 755 "${DEB_ROOT}${APP_INSTALL_DIR}/app"

find "${DEB_ROOT}${APP_INSTALL_DIR}/app" \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \;

chmod 755 "${DEB_ROOT}${DATA_DIR}"
chmod 755 "${DEB_ROOT}${UPLOAD_DIR}"
chmod 755 "${DEB_ROOT}${REPORT_DIR}"
chmod 755 "${DEB_ROOT}${LOG_DIR}"

echo "✅ Package permissions configured."

# ============================================================
# Verify launcher BEFORE building
# ============================================================

echo
echo "🔍 Verifying launcher..."

if [ ! -f "${DEB_ROOT}${BIN_FILE}" ]; then

    echo "❌ ERROR: launcher does not exist:"
    echo "   ${DEB_ROOT}${BIN_FILE}"

    exit 1

fi

if [ ! -x "${DEB_ROOT}${BIN_FILE}" ]; then

    echo "❌ ERROR: launcher is not executable:"
    echo "   ${DEB_ROOT}${BIN_FILE}"

    exit 1

fi

echo "✅ Launcher exists and is executable."

# ============================================================
# Verify main.py
# ============================================================

if [ ! -f "${DEB_ROOT}${APP_INSTALL_DIR}/app/main.py" ]; then

    echo "❌ ERROR: main.py missing from package tree."

    exit 1

fi

echo "✅ main.py exists."

# ============================================================
# Build .deb
# ============================================================

echo
echo "📦 Building Debian package..."

dpkg-deb \
    --build \
    --root-owner-group \
    "${DEB_ROOT}" \
    "${PACKAGE_FILE}"

echo

if [ ! -f "${PACKAGE_FILE}" ]; then

    echo "❌ Package was not created."

    exit 1

fi

echo "✅ Debian package created:"
echo "   ${PACKAGE_FILE}"

# ============================================================
# Verify .deb contents
# ============================================================

echo
echo "🔍 Verifying package contents..."

if dpkg-deb -c "${PACKAGE_FILE}" | \
    grep -qE '[[:space:]]\./usr/bin/sarabis$'; then

    echo "✅ /usr/bin/sarabis is inside the .deb"

else

    echo "❌ ERROR: /usr/bin/sarabis is missing from the .deb"

    exit 1

fi

if dpkg-deb -c "${PACKAGE_FILE}" | \
    grep -qE '[[:space:]]\./usr/share/sarabis/app/main.py$'; then

    echo "✅ main.py is inside the .deb"

else

    echo "❌ ERROR: main.py is missing from the .deb"

    exit 1

fi

# ============================================================
# Verify runtime directories
# ============================================================

if dpkg-deb -c "${PACKAGE_FILE}" | \
    grep -qE '[[:space:]]\./var/lib/sarabis/logs/$'; then

    echo "✅ /var/lib/sarabis/logs/ exists in the .deb"

else

    echo "⚠️ Runtime log directory was not listed explicitly."
    echo "This is normally harmless because empty directories may"
    echo "not be stored by dpkg-deb."

fi

# ============================================================
# Extract and verify maintainer scripts
# ============================================================

echo
echo "🔍 Verifying maintainer scripts..."

CONTROL_CHECK="/tmp/${APP_NAME}-control-check-$$"

rm -rf "$CONTROL_CHECK"

dpkg-deb -e "${PACKAGE_FILE}" "$CONTROL_CHECK"

if [ ! -f "$CONTROL_CHECK/postinst" ]; then

    echo "❌ postinst missing."

    rm -rf "$CONTROL_CHECK"

    exit 1

fi

echo "✅ postinst found."

if [ ! -f "$CONTROL_CHECK/postrm" ]; then

    echo "❌ postrm missing."

    rm -rf "$CONTROL_CHECK"

    exit 1

fi

echo "✅ postrm found."

# ------------------------------------------------------------
# Make sure old destructive launcher removal is absent.
# ------------------------------------------------------------

if grep -Eq \
    'rm[[:space:]]+-f[[:space:]]+["'\'']?/usr/bin/sarabis' \
    "$CONTROL_CHECK/postrm"; then

    echo
    echo "❌ ERROR:"
    echo "postrm still contains direct launcher deletion."

    rm -rf "$CONTROL_CHECK"

    exit 1

fi

echo "✅ postrm does not directly remove /usr/bin/sarabis."

rm -rf "$CONTROL_CHECK"

# ============================================================
# Show package contents
# ============================================================

echo
echo "📋 Important package files:"

dpkg-deb -c "${PACKAGE_FILE}" | \
    grep -E \
    'usr/bin/sarabis|usr/share/sarabis/app/main.py|usr/share/applications/sarabis.desktop|etc/sarabis' \
    || true

# ============================================================
# Final result
# ============================================================

echo
echo "============================================================"
echo "              BUILD SUCCESSFUL"
echo "============================================================"
echo
echo "Package:"
echo "  ${PACKAGE_FILE}"
echo
echo "Install:"
echo "  sudo apt install --reinstall ./${PACKAGE_FILE}"
echo
echo "Run:"
echo "  sarabis"
echo
echo "Web:"
echo "  ${APP_URL}"
echo
echo "Launcher:"
echo "  /usr/bin/sarabis"
echo
echo "Configuration:"
echo "  /etc/sarabis/settings.py"
echo
echo "Uploads:"
echo "  /var/lib/sarabis/uploads/"
echo
echo "Reports:"
echo "  /var/lib/sarabis/reports/"
echo
echo "Logs:"
echo "  /var/lib/sarabis/logs/sarabis.log"
echo
echo "============================================================"
