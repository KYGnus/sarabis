#!/bin/bash

set -Eeuo pipefail

# ============================================================
# sarabis Security Analyzer - RPM Package Builder
# ============================================================

APP_NAME="sarabis"
VERSION="1.1.0"
RELEASE="1"
ARCHITECTURE="noarch"

MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="sarabis Security Analyzer - Comprehensive remote Linux system security analysis platform"

APP_URL="http://localhost:8080"
APP_URL_SITE="https://kygnus.github.io/"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ============================================================
# Source
# ============================================================

APP_SOURCE_DIR="${SCRIPT_DIR}/app"
REQUIREMENTS_FILE="${SCRIPT_DIR}/requirements.txt"
SETUP_FILE="${SCRIPT_DIR}/setup.py"

# ============================================================
# Build directories
# ============================================================

BUILD_DIR="${SCRIPT_DIR}/rpm_package"

RPM_ROOT="${BUILD_DIR}/rpmbuild"

SOURCES_DIR="${RPM_ROOT}/SOURCES"
SPECS_DIR="${RPM_ROOT}/SPECS"
BUILD_RPM_DIR="${RPM_ROOT}/BUILD"
BUILDROOT_DIR="${RPM_ROOT}/BUILDROOT"
RPMS_DIR="${RPM_ROOT}/RPMS"
SRPMS_DIR="${RPM_ROOT}/SRPMS"

SOURCE_TREE="${BUILD_DIR}/${APP_NAME}-${VERSION}"

TMP_DIR="${BUILD_DIR}/tmp"

# ============================================================
# Output
# ============================================================

DIST_DIR="${SCRIPT_DIR}/dist"

PACKAGE_FILE="${DIST_DIR}/${APP_NAME}-${VERSION}-${RELEASE}.${ARCHITECTURE}.rpm"

SPEC_FILE="${SPECS_DIR}/${APP_NAME}.spec"

SOURCE_TARBALL="${SOURCES_DIR}/${APP_NAME}-${VERSION}.tar.gz"

# ============================================================
# Installation paths
# ============================================================

APP_INSTALL_DIR="/usr/share/${APP_NAME}"

APP_CODE_DIR="${APP_INSTALL_DIR}/app"

CONFIG_DIR="/etc/${APP_NAME}"

DATA_DIR="/var/lib/${APP_NAME}"

UPLOAD_DIR="${DATA_DIR}/uploads"
REPORT_DIR="${DATA_DIR}/reports"
LOG_DIR="${DATA_DIR}/logs"

BIN_DIR="/usr/bin"
BIN_FILE="${BIN_DIR}/${APP_NAME}"

DESKTOP_DIR="/usr/share/applications"
DESKTOP_FILE="${DESKTOP_DIR}/${APP_NAME}.desktop"

DOC_DIR="/usr/share/doc/packages/${APP_NAME}"

SYSTEMD_DIR="/usr/lib/systemd/system"
SYSTEMD_FILE="${SYSTEMD_DIR}/${APP_NAME}.service"

# ============================================================
# Functions
# ============================================================

die()
{
    echo
    echo "❌ ERROR: $*"
    echo
    exit 1
}

command_exists()
{
    command -v "$1" >/dev/null 2>&1
}

# ============================================================
# Header
# ============================================================

echo
echo "============================================================"
echo "       ${APP_NAME} Security Analyzer RPM Builder"
echo "============================================================"
echo
echo "Package:      ${APP_NAME}"
echo "Version:      ${VERSION}"
echo "Release:      ${RELEASE}"
echo "Architecture: ${ARCHITECTURE}"
echo "URL:          ${APP_URL}"
echo

# ============================================================
# Root check
# ============================================================

if [ "${EUID}" -eq 0 ]; then

    die "Do not run this builder as root.

Run:

    ./build-rpm"

fi

# ============================================================
# Check source
# ============================================================

echo "🔍 Checking application source..."

if [ ! -d "${APP_SOURCE_DIR}" ]; then

    die "app/ directory not found.

Run this script from the sarabis project directory."

fi

if [ ! -f "${APP_SOURCE_DIR}/main.py" ]; then

    die "app/main.py not found."

fi

echo "✅ app/main.py found"

# ============================================================
# Check RPM tools
# ============================================================

echo
echo "🔍 Checking RPM build requirements..."

if ! command_exists rpm || ! command_exists rpmbuild; then

    echo "⚠️ RPM build tools are missing."

    if command_exists zypper; then

        echo "📦 Installing rpm and rpm-build..."

        sudo zypper --non-interactive install rpm rpm-build

    elif command_exists dnf; then

        echo "📦 Installing rpm and rpm-build..."

        sudo dnf install rpm rpm-build

    elif command_exists yum; then

        echo "📦 Installing rpm and rpm-build..."

        sudo yum install rpm rpm-build

    else

        die "Could not find zypper, dnf, or yum."

    fi

fi

if ! command_exists rpm; then
    die "rpm command is not available."
fi

if ! command_exists rpmbuild; then
    die "rpmbuild command is not available."
fi

echo "✅ rpm found:      $(command -v rpm)"
echo "✅ rpmbuild found: $(command -v rpmbuild)"

# ============================================================
# Python check
# ============================================================

echo
echo "🔍 Checking Python..."

if ! command_exists python3; then

    die "python3 is required."

fi

echo "✅ $(python3 --version)"

# ============================================================
# Clean previous builds
# ============================================================

echo
echo "🧹 Cleaning previous builds..."

rm -rf "${BUILD_DIR}"
rm -rf "${DIST_DIR}"

mkdir -p \
    "${SOURCES_DIR}" \
    "${SPECS_DIR}" \
    "${BUILD_RPM_DIR}" \
    "${BUILDROOT_DIR}" \
    "${RPMS_DIR}" \
    "${SRPMS_DIR}" \
    "${TMP_DIR}" \
    "${DIST_DIR}"

echo "✅ Build directories created."

# ============================================================
# Create source tree
# ============================================================

echo
echo "📁 Creating RPM source tree..."

mkdir -p \
    "${SOURCE_TREE}${APP_CODE_DIR}" \
    "${SOURCE_TREE}${CONFIG_DIR}" \
    "${SOURCE_TREE}${DATA_DIR}" \
    "${SOURCE_TREE}${UPLOAD_DIR}" \
    "${SOURCE_TREE}${REPORT_DIR}" \
    "${SOURCE_TREE}${LOG_DIR}" \
    "${SOURCE_TREE}${BIN_DIR}" \
    "${SOURCE_TREE}${DESKTOP_DIR}" \
    "${SOURCE_TREE}${DOC_DIR}" \
    "${SOURCE_TREE}${SYSTEMD_DIR}"

echo "✅ Source tree created."

# ============================================================
# Copy application
# ============================================================

echo
echo "📦 Copying application files..."

cp -a \
    "${APP_SOURCE_DIR}/." \
    "${SOURCE_TREE}${APP_CODE_DIR}/"

echo "✅ Application copied."

# ============================================================
# requirements.txt
# ============================================================

if [ -f "${REQUIREMENTS_FILE}" ]; then

    echo "📦 Copying requirements.txt..."

    cp \
        "${REQUIREMENTS_FILE}" \
        "${SOURCE_TREE}${APP_INSTALL_DIR}/requirements.txt"

    echo "✅ requirements.txt copied."

else

    echo "⚠️ requirements.txt not found."

fi

# ============================================================
# setup.py
# ============================================================

if [ -f "${SETUP_FILE}" ]; then

    echo "📦 Copying setup.py..."

    cp \
        "${SETUP_FILE}" \
        "${SOURCE_TREE}${APP_INSTALL_DIR}/setup.py"

    echo "✅ setup.py copied."

fi

# ============================================================
# app/__init__.py
# ============================================================

if [ ! -f "${SOURCE_TREE}${APP_CODE_DIR}/__init__.py" ]; then

    echo "📄 Creating app/__init__.py..."

    touch "${SOURCE_TREE}${APP_CODE_DIR}/__init__.py"

fi

# ============================================================
# Verify main.py
# ============================================================

if [ ! -f "${SOURCE_TREE}${APP_CODE_DIR}/main.py" ]; then

    die "main.py was not copied into the RPM source tree."

fi

echo "✅ main.py verified."

# ============================================================
# Default configuration
# ============================================================

echo
echo "⚙️ Creating default configuration..."

cat > "${SOURCE_TREE}${CONFIG_DIR}/settings.py" <<'CONFIGEOF'
# ============================================================
# sarabis Security Analyzer Configuration
# ============================================================

HOST = "127.0.0.1"
PORT = 8080

DEBUG = False

# ------------------------------------------------------------
# Application directories
# ------------------------------------------------------------

UPLOAD_DIR = "/var/lib/sarabis/uploads"
REPORT_DIR = "/var/lib/sarabis/reports"
LOG_DIR = "/var/lib/sarabis/logs"

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

SECRET_KEY = "sarabis-change-this-secret-key"

# ------------------------------------------------------------
# Default administrator
# ------------------------------------------------------------

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "admin"
CONFIGEOF

chmod 644 "${SOURCE_TREE}${CONFIG_DIR}/settings.py"

# ============================================================
# /usr/bin/sarabis launcher
# ============================================================

echo
echo "🖥️ Creating /usr/bin/sarabis launcher..."

cat > "${SOURCE_TREE}${BIN_FILE}" <<'LAUNCHER'
#!/bin/bash

# ============================================================
# sarabis Security Analyzer launcher
# ============================================================

APP_DIR="/usr/share/sarabis"

APP_URL="http://localhost:8080"

VENV_PYTHON="$APP_DIR/venv/bin/python"

MAIN_APP="$APP_DIR/app/main.py"

DATA_DIR="/var/lib/sarabis"

LOG_DIR="$DATA_DIR/logs"

LOG_FILE="$LOG_DIR/sarabis.log"

# ============================================================
# Browser
# ============================================================

open_browser()
{
    if command -v xdg-open >/dev/null 2>&1; then

        xdg-open "$APP_URL" >/dev/null 2>&1 &

    elif command -v sensible-browser >/dev/null 2>&1; then

        sensible-browser "$APP_URL" >/dev/null 2>&1 &

    elif command -v firefox >/dev/null 2>&1; then

        firefox "$APP_URL" >/dev/null 2>&1 &

    elif command -v chromium >/dev/null 2>&1; then

        chromium "$APP_URL" >/dev/null 2>&1 &

    elif command -v chromium-browser >/dev/null 2>&1; then

        chromium-browser "$APP_URL" >/dev/null 2>&1 &

    else

        echo "⚠️ No supported browser found."
        echo "Open manually: $APP_URL"

    fi
}

# ============================================================
# Verify application
# ============================================================

if [ ! -f "$MAIN_APP" ]; then

    echo
    echo "❌ ERROR: sarabis application not found:"
    echo
    echo "   $MAIN_APP"
    echo

    exit 1

fi

# ============================================================
# Verify Python virtual environment
# ============================================================

if [ ! -x "$VENV_PYTHON" ]; then

    echo
    echo "❌ ERROR: Python virtual environment not found:"
    echo
    echo "   $VENV_PYTHON"
    echo
    echo "If this is a new installation, wait for package"
    echo "configuration to finish or reinstall the package."
    echo

    exit 1

fi

# ============================================================
# Create log directory
# ============================================================

mkdir -p "$LOG_DIR" 2>/dev/null || true

# ============================================================
# Check whether sarabis is already running
# ============================================================

if command -v curl >/dev/null 2>&1; then

    if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

        echo
        echo "sarabis is already running."
        echo
        echo "🌐 Opening:"
        echo "   $APP_URL"
        echo

        open_browser

        exit 0

    fi

fi

# ============================================================
# Determine log file
# ============================================================

LOG_ENABLED=0

if touch "$LOG_FILE" >/dev/null 2>&1; then

    LOG_ENABLED=1

else

    LOG_FILE="/tmp/sarabis-${USER:-user}.log"

    touch "$LOG_FILE" >/dev/null 2>&1 || true

    echo
    echo "⚠️ Warning: Cannot write to:"
    echo
    echo "   /var/lib/sarabis/logs/"
    echo
    echo "Using temporary log:"
    echo
    echo "   $LOG_FILE"
    echo

fi

# ============================================================
# Start Flask application
# ============================================================

echo
echo "🚀 Starting sarabis Security Analyzer..."
echo
echo "🌐 URL:"
echo "   $APP_URL"
echo

if [ "$LOG_ENABLED" -eq 1 ]; then

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >> "$LOG_FILE" 2>&1 &

else

    nohup "$VENV_PYTHON" "$MAIN_APP" "$@" \
        >/dev/null 2>&1 &

fi

SARABIS_PID=$!

echo "sarabis started."
echo "PID: $SARABIS_PID"

# ============================================================
# Wait for server
# ============================================================

echo
echo "⏳ Waiting for web interface..."

SERVER_READY=0

for i in $(seq 1 30); do

    sleep 1

    if ! kill -0 "$SARABIS_PID" 2>/dev/null; then

        echo
        echo "❌ sarabis process exited unexpectedly."
        echo

        if [ -f "$LOG_FILE" ]; then

            echo "Last log output:"
            echo

            tail -n 30 "$LOG_FILE" 2>/dev/null || true

        fi

        exit 1

    fi

    if command -v curl >/dev/null 2>&1; then

        if curl -fsS --max-time 2 "$APP_URL" >/dev/null 2>&1; then

            SERVER_READY=1

            break

        fi

    fi

done

# ============================================================
# Server status
# ============================================================

echo

if [ "$SERVER_READY" -eq 1 ]; then

    echo "✅ sarabis web interface is ready."
    echo
    echo "🌐 $APP_URL"

else

    echo "⚠️ Web interface did not respond within 30 seconds."
    echo
    echo "Check:"
    echo
    echo "  $LOG_FILE"

fi

# ============================================================
# Open browser
# ============================================================

open_browser

exit 0
LAUNCHER

chmod 755 "${SOURCE_TREE}${BIN_FILE}"

echo "✅ Launcher created."

# ============================================================
# Desktop launcher
# ============================================================

echo
echo "🖥️ Creating desktop launcher..."

cat > "${SOURCE_TREE}${DESKTOP_FILE}" <<'DESKTOPEOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=sarabis Security Analyzer
GenericName=Security Analyzer
Comment=Comprehensive Linux Security Analysis Platform
Exec=/usr/bin/sarabis
TryExec=/usr/bin/sarabis
Icon=security
Terminal=false
StartupNotify=true
Categories=Network;Security;System;
Keywords=security;analysis;audit;ssh;scanning;linux;
DESKTOPEOF

chmod 644 "${SOURCE_TREE}${DESKTOP_FILE}"

# ============================================================
# systemd service
# ============================================================

echo
echo "⚙️ Creating systemd service..."

cat > "${SOURCE_TREE}${SYSTEMD_FILE}" <<'SERVICEEOF'
[Unit]
Description=sarabis Security Analyzer
After=network.target

[Service]
Type=simple
WorkingDirectory=/usr/share/sarabis
ExecStart=/usr/share/sarabis/venv/bin/python /usr/share/sarabis/app/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICEEOF

chmod 644 "${SOURCE_TREE}${SYSTEMD_FILE}"

# ============================================================
# Documentation
# ============================================================

echo
echo "📚 Creating documentation..."

cat > "${SOURCE_TREE}${DOC_DIR}/README.SUSE" <<'DOCEOF'
sarabis Security Analyzer
=========================

Command:
    sarabis

Web interface:
    http://localhost:8080

Configuration:
    /etc/sarabis/settings.py

Application:
    /usr/share/sarabis/

Application data:
    /var/lib/sarabis/

Uploads:
    /var/lib/sarabis/uploads/

Reports:
    /var/lib/sarabis/reports/

Logs:
    /var/lib/sarabis/logs/

Main log:
    /var/lib/sarabis/logs/sarabis.log

Default credentials:
    Username: admin
    Password: admin

antiX / SysVinit:
    sarabis runs through /usr/bin/sarabis.

systemd:
    sarabis.service is installed when systemd is available.

Important:
    Change the default administrator credentials before
    using sarabis in a production environment.
DOCEOF

chmod 644 "${SOURCE_TREE}${DOC_DIR}/README.SUSE"

if [ -f "${SCRIPT_DIR}/README.md" ]; then

    echo "📄 Copying README.md..."

    cp \
        "${SCRIPT_DIR}/README.md" \
        "${SOURCE_TREE}${DOC_DIR}/README.md"

    chmod 644 "${SOURCE_TREE}${DOC_DIR}/README.md"

fi

if [ -f "${SCRIPT_DIR}/LICENSE" ]; then

    echo "📄 Copying LICENSE..."

    cp \
        "${SCRIPT_DIR}/LICENSE" \
        "${SOURCE_TREE}${DOC_DIR}/LICENSE"

    chmod 644 "${SOURCE_TREE}${DOC_DIR}/LICENSE"

fi

cat > "${SOURCE_TREE}${DOC_DIR}/COPYING" <<'COPYEOF'
Copyright (c) KYGnus

All rights reserved.
COPYEOF

chmod 644 "${SOURCE_TREE}${DOC_DIR}/COPYING"

# ============================================================
# Verify source tree
# ============================================================

echo
echo "🔍 Verifying source tree..."

test -f "${SOURCE_TREE}${APP_CODE_DIR}/main.py" \
    || die "main.py missing."

test -f "${SOURCE_TREE}${BIN_FILE}" \
    || die "/usr/bin/sarabis missing."

test -f "${SOURCE_TREE}${CONFIG_DIR}/settings.py" \
    || die "settings.py missing."

test -f "${SOURCE_TREE}${DESKTOP_FILE}" \
    || die "Desktop file missing."

test -f "${SOURCE_TREE}${SYSTEMD_FILE}" \
    || die "systemd service missing."

echo "✅ Source tree verified."

# ============================================================
# Shell syntax check
# ============================================================

echo
echo "🔍 Checking launcher syntax..."

bash -n "${SOURCE_TREE}${BIN_FILE}"

echo "✅ Launcher syntax OK."

# ============================================================
# Package permissions
# ============================================================

echo
echo "🔧 Configuring package permissions..."

chmod 755 \
    "${SOURCE_TREE}${APP_INSTALL_DIR}"

chmod 755 \
    "${SOURCE_TREE}${APP_CODE_DIR}"

find "${SOURCE_TREE}${APP_CODE_DIR}" \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \;

chmod 755 \
    "${SOURCE_TREE}${BIN_FILE}"

chmod 644 \
    "${SOURCE_TREE}${DESKTOP_FILE}"

chmod 644 \
    "${SOURCE_TREE}${SYSTEMD_FILE}"

chmod 755 \
    "${SOURCE_TREE}${DATA_DIR}"

chmod 755 \
    "${SOURCE_TREE}${UPLOAD_DIR}"

chmod 755 \
    "${SOURCE_TREE}${REPORT_DIR}"

chmod 755 \
    "${SOURCE_TREE}${LOG_DIR}"

echo "✅ Permissions configured."

# ============================================================
# Create source tarball
# ============================================================

echo
echo "📦 Creating source archive..."

tar \
    -C "${BUILD_DIR}" \
    -czf "${SOURCE_TARBALL}" \
    "${APP_NAME}-${VERSION}"

echo "✅ Source archive created:"
echo
echo "   ${SOURCE_TARBALL}"

# ============================================================
# Create SPEC
#
# IMPORTANT:
# Single-quoted heredoc prevents Bash from expanding RPM
# macros such as %{buildroot}, %{_bindir}, etc.
# ============================================================

echo
echo "📝 Creating RPM SPEC file..."

cat > "${SPEC_FILE}" <<'SPECEOF'
Name:           @APP_NAME@
Version:        @VERSION@
Release:        @RELEASE@%{?dist}

Summary:        @DESCRIPTION@

License:        Proprietary

URL:            @APP_URL_SITE@

Source0:        %{name}-%{version}.tar.gz

BuildArch:      noarch

# ============================================================
# Runtime dependencies
# ============================================================

Requires:       python3
Requires:       python3-pip
Requires:       python3-venv
Requires:       openssh
Requires:       curl
Requires:       xdg-utils

# ============================================================
# Optional build/runtime tools
# ============================================================

Recommends:     gcc
Recommends:     gcc-c++

%description
sarabis is a comprehensive Linux security analysis platform.

It provides:

* Remote Linux system security analysis
* SSH-based auditing
* Security assessment
* Report generation
* Upload and report management
* Local Flask web interface

Web interface:

@APP_URL@

%prep

%setup -q

%build

# No native compilation is required.
# sarabis is a Python application.

%install

# ============================================================
# Create installation directories
# ============================================================

mkdir -p %{buildroot}%{_datadir}/sarabis
mkdir -p %{buildroot}%{_datadir}/sarabis/app

mkdir -p %{buildroot}%{_sysconfdir}/sarabis

mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/uploads
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/reports
mkdir -p %{buildroot}%{_localstatedir}/lib/sarabis/logs

mkdir -p %{buildroot}%{_bindir}

mkdir -p %{buildroot}%{_datadir}/applications

mkdir -p %{buildroot}%{_docdir}/sarabis

mkdir -p %{buildroot}%{_unitdir}

# ============================================================
# Application
# ============================================================

cp -a \
    usr/share/sarabis/app/. \
    %{buildroot}%{_datadir}/sarabis/app/

# ============================================================
# requirements.txt
# ============================================================

if [ -f usr/share/sarabis/requirements.txt ]; then

    cp \
        usr/share/sarabis/requirements.txt \
        %{buildroot}%{_datadir}/sarabis/requirements.txt

fi

# ============================================================
# setup.py
# ============================================================

if [ -f usr/share/sarabis/setup.py ]; then

    cp \
        usr/share/sarabis/setup.py \
        %{buildroot}%{_datadir}/sarabis/setup.py

fi

# ============================================================
# Configuration
# ============================================================

cp \
    etc/sarabis/settings.py \
    %{buildroot}%{_sysconfdir}/sarabis/settings.py

# ============================================================
# Launcher
# ============================================================

cp \
    usr/bin/sarabis \
    %{buildroot}%{_bindir}/sarabis

# ============================================================
# Desktop entry
# ============================================================

cp \
    usr/share/applications/sarabis.desktop \
    %{buildroot}%{_datadir}/applications/sarabis.desktop

# ============================================================
# Documentation
# ============================================================

cp \
    usr/share/doc/packages/sarabis/README.SUSE \
    %{buildroot}%{_docdir}/sarabis/README.SUSE

if [ -f usr/share/doc/packages/sarabis/README.md ]; then

    cp \
        usr/share/doc/packages/sarabis/README.md \
        %{buildroot}%{_docdir}/sarabis/README.md

fi

if [ -f usr/share/doc/packages/sarabis/LICENSE ]; then

    cp \
        usr/share/doc/packages/sarabis/LICENSE \
        %{buildroot}%{_docdir}/sarabis/LICENSE

fi

cp \
    usr/share/doc/packages/sarabis/COPYING \
    %{buildroot}%{_docdir}/sarabis/COPYING

# ============================================================
# systemd service
# ============================================================

cp \
    usr/lib/systemd/system/sarabis.service \
    %{buildroot}%{_unitdir}/sarabis.service

# ============================================================
# Permissions
# ============================================================

chmod 755 \
    %{buildroot}%{_bindir}/sarabis

find %{buildroot}%{_datadir}/sarabis/app \
    -type f \
    -name "*.py" \
    -exec chmod 644 {} \;

# ============================================================
# Pre-install
# ============================================================

%pre

mkdir -p /etc/sarabis

mkdir -p /var/lib/sarabis
mkdir -p /var/lib/sarabis/uploads
mkdir -p /var/lib/sarabis/reports
mkdir -p /var/lib/sarabis/logs

exit 0

# ============================================================
# Post-install
# ============================================================

%post

APP_DIR="/usr/share/sarabis"

CONFIG_DIR="/etc/sarabis"

DATA_DIR="/var/lib/sarabis"

UPLOAD_DIR="/var/lib/sarabis/uploads"

REPORT_DIR="/var/lib/sarabis/reports"

LOG_DIR="/var/lib/sarabis/logs"

BIN_FILE="/usr/bin/sarabis"

echo
echo "============================================================"
echo " Configuring sarabis Security Analyzer"
echo "============================================================"
echo

# ============================================================
# Runtime directories
# ============================================================

mkdir -p "$CONFIG_DIR"

mkdir -p "$DATA_DIR"
mkdir -p "$UPLOAD_DIR"
mkdir -p "$REPORT_DIR"
mkdir -p "$LOG_DIR"

# ============================================================
# Python virtual environment
# ============================================================

if [ ! -x "$APP_DIR/venv/bin/python" ]; then

    echo "🐍 Creating Python virtual environment..."

    if command -v python3 >/dev/null 2>&1; then

        python3 -m venv "$APP_DIR/venv" || {

            echo
            echo "⚠️ Warning:"
            echo "Unable to create Python virtual environment."
            echo

        }

    fi

fi

# ============================================================
# Python dependencies
# ============================================================

if [ -x "$APP_DIR/venv/bin/python" ] &&
   [ -f "$APP_DIR/requirements.txt" ]; then

    echo
    echo "📦 Installing Python dependencies..."

    "$APP_DIR/venv/bin/python" -m pip install \
        --disable-pip-version-check \
        --no-input \
        -r "$APP_DIR/requirements.txt" || {

        echo
        echo "⚠️ Warning:"
        echo "Some Python dependencies could not be installed."
        echo "RPM installation will continue."
        echo

    }

fi

# ============================================================
# Configuration
#
# Do not overwrite existing settings.py during upgrades.
# ============================================================

if [ ! -f "$CONFIG_DIR/settings.py" ]; then

    cat > "$CONFIG_DIR/settings.py" <<'CONFIGEOF'
# ============================================================
# sarabis Security Analyzer Configuration
# ============================================================

HOST = "127.0.0.1"
PORT = 8080

DEBUG = False

UPLOAD_DIR = "/var/lib/sarabis/uploads"
REPORT_DIR = "/var/lib/sarabis/reports"
LOG_DIR = "/var/lib/sarabis/logs"

SECRET_KEY = "sarabis-change-this-secret-key"

ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "admin"
CONFIGEOF

    chmod 644 "$CONFIG_DIR/settings.py"

fi

# ============================================================
# Admin credentials
# ============================================================

if [ ! -f "$APP_DIR/.admin_credentials" ]; then

    cat > "$APP_DIR/.admin_credentials" <<'CREDENTIALSEOF'
username=admin
password=admin
CREDENTIALSEOF

    chmod 600 "$APP_DIR/.admin_credentials"

fi

# ============================================================
# systemd detection
# ============================================================

if [ -d /run/systemd/system ] &&
   command -v systemctl >/dev/null 2>&1; then

    echo
    echo "⚙️ systemd detected."

    systemctl daemon-reload \
        >/dev/null 2>&1 || true

    echo
    echo "Service available:"
    echo
    echo "  sudo systemctl start sarabis"
    echo "  sudo systemctl enable sarabis"
    echo

else

    echo
    echo "ℹ️ Non-systemd environment detected."
    echo
    echo "Run sarabis with:"
    echo
    echo "  sarabis"
    echo

fi

# ============================================================
# Desktop database
# ============================================================

if command -v update-desktop-database >/dev/null 2>&1; then

    update-desktop-database \
        /usr/share/applications \
        >/dev/null 2>&1 || true

fi

# ============================================================
# Verify launcher
# ============================================================

if [ ! -f "$BIN_FILE" ]; then

    echo
    echo "❌ ERROR: $BIN_FILE is missing."
    exit 1

fi

if [ ! -x "$BIN_FILE" ]; then

    echo
    echo "❌ ERROR: $BIN_FILE is not executable."
    exit 1

fi

# ============================================================
# Installation summary
# ============================================================

echo
echo "============================================================"
echo " sarabis installation completed"
echo "============================================================"
echo
echo "Command:"
echo "  sarabis"
echo
echo "Web interface:"
echo "  http://localhost:8080"
echo
echo "Configuration:"
echo "  /etc/sarabis/settings.py"
echo
echo "Application:"
echo "  /usr/share/sarabis/"
echo
echo "Uploads:"
echo "  /var/lib/sarabis/uploads/"
echo
echo "Reports:"
echo "  /var/lib/sarabis/reports/"
echo
echo "Logs:"
echo "  /var/lib/sarabis/logs/sarabis.log"
echo
echo "Default credentials:"
echo "  Username: admin"
echo "  Password: admin"
echo
echo "Launcher:"
echo "  /usr/bin/sarabis"
echo

exit 0

# ============================================================
# Pre-uninstall
# ============================================================

%preun

if [ "$1" -eq 0 ]; then

    if command -v systemctl >/dev/null 2>&1; then

        systemctl disable --now sarabis.service \
            >/dev/null 2>&1 || true

    fi

fi

exit 0

# ============================================================
# Post-uninstall
# ============================================================

%postun

if [ "$1" -eq 0 ]; then

    if command -v systemctl >/dev/null 2>&1; then

        systemctl daemon-reload \
            >/dev/null 2>&1 || true

    fi

    # Runtime data is intentionally preserved.
    #
    # Remove manually if required:
    #
    #   sudo rm -rf /var/lib/sarabis

fi

exit 0

# ============================================================
# Files
# ============================================================

%files

%defattr(-,root,root,-)

# ------------------------------------------------------------
# Launcher
# ------------------------------------------------------------

%attr(0755,root,root) %{_bindir}/sarabis

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

%dir %{_datadir}/sarabis

%dir %{_datadir}/sarabis/app

%{_datadir}/sarabis/app/*

%{_datadir}/sarabis/requirements.txt

%if 0%{?exists:%{_datadir}/sarabis/setup.py}
%{_datadir}/sarabis/setup.py
%endif

# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

%config(noreplace) %{_sysconfdir}/sarabis/settings.py

# ------------------------------------------------------------
# Runtime directories
# ------------------------------------------------------------

%dir %{_localstatedir}/lib/sarabis

%dir %{_localstatedir}/lib/sarabis/uploads

%dir %{_localstatedir}/lib/sarabis/reports

%dir %{_localstatedir}/lib/sarabis/logs

# ------------------------------------------------------------
# Desktop launcher
# ------------------------------------------------------------

%{_datadir}/applications/sarabis.desktop

# ------------------------------------------------------------
# systemd service
# ------------------------------------------------------------

%{_unitdir}/sarabis.service

# ------------------------------------------------------------
# Documentation
# ------------------------------------------------------------

%doc %{_docdir}/sarabis/README.SUSE

%doc %{_docdir}/sarabis/COPYING

%if 0%{?exists:%{_docdir}/sarabis/README.md}
%doc %{_docdir}/sarabis/README.md
%endif

%if 0%{?exists:%{_docdir}/sarabis/LICENSE}
%doc %{_docdir}/sarabis/LICENSE
%endif

# ============================================================
# Changelog
# ============================================================

%changelog
* Thu Sep 24 2026 KYGnus <kygnus.co@proton.me> - @VERSION@-@RELEASE@
- Initial RPM package for sarabis Security Analyzer
SPECEOF

# ============================================================
# Replace SPEC placeholders
# ============================================================

sed -i \
    -e "s|@APP_NAME@|${APP_NAME}|g" \
    -e "s|@VERSION@|${VERSION}|g" \
    -e "s|@RELEASE@|${RELEASE}|g" \
    -e "s|@DESCRIPTION@|${DESCRIPTION}|g" \
    -e "s|@APP_URL@|${APP_URL}|g" \
    -e "s|@APP_URL_SITE@|${APP_URL_SITE}|g" \
    "${SPEC_FILE}"

echo "✅ SPEC file created:"
echo
echo "   ${SPEC_FILE}"

# ============================================================
# Build RPM
# ============================================================

echo
echo "📦 Building RPM package..."
echo

rpmbuild \
    --define "_topdir ${RPM_ROOT}" \
    --define "_builddir ${BUILD_RPM_DIR}" \
    --define "_buildrootdir ${BUILDROOT_DIR}" \
    --define "_rpmdir ${RPMS_DIR}" \
    --define "_srcrpmdir ${SRPMS_DIR}" \
    --define "_sourcedir ${SOURCES_DIR}" \
    --define "_specdir ${SPECS_DIR}" \
    --define "_tmppath ${TMP_DIR}" \
    --define "debug_package %{nil}" \
    -bb \
    "${SPEC_FILE}"

echo
echo "✅ rpmbuild completed."

# ============================================================
# Find real sarabis RPM
# ============================================================

echo
echo "🔍 Locating generated RPM..."

BUILT_RPM=""

while IFS= read -r RPM_FILE; do

    [ -f "$RPM_FILE" ] || continue

    RPM_NAME="$(
        rpm -qp \
            --qf '%{NAME}' \
            "$RPM_FILE" \
            2>/dev/null || true
    )"

    RPM_VERSION="$(
        rpm -qp \
            --qf '%{VERSION}' \
            "$RPM_FILE" \
            2>/dev/null || true
    )"

    RPM_ARCH="$(
        rpm -qp \
            --qf '%{ARCH}' \
            "$RPM_FILE" \
            2>/dev/null || true
    )"

    if [ "$RPM_NAME" = "$APP_NAME" ] &&
       [ "$RPM_VERSION" = "$VERSION" ] &&
       [ "$RPM_ARCH" = "$ARCHITECTURE" ]; then

        BUILT_RPM="$RPM_FILE"

        echo
        echo "✅ Correct RPM found:"
        echo
        echo "   $RPM_FILE"
        echo
        echo "   Name:    $RPM_NAME"
        echo "   Version: $RPM_VERSION"
        echo "   Arch:    $RPM_ARCH"

        break

    fi

done < <(
    find "${RPMS_DIR}" \
        -type f \
        -name "*.rpm" \
        -print \
        | sort
)

# ============================================================
# Validate generated RPM
# ============================================================

if [ -z "${BUILT_RPM}" ]; then

    echo
    echo "❌ Could not find the real ${APP_NAME} RPM."
    echo
    echo "Generated RPM files:"
    echo

    find "${RPMS_DIR}" \
        -type f \
        -name "*.rpm" \
        -print \
        | sort || true

    exit 1

fi

# ============================================================
# RPM metadata verification
# ============================================================

echo
echo "🔍 Verifying RPM metadata..."

CHECK_NAME="$(
    rpm -qp \
        --qf '%{NAME}' \
        "${BUILT_RPM}"
)"

CHECK_VERSION="$(
    rpm -qp \
        --qf '%{VERSION}' \
        "${BUILT_RPM}"
)"

CHECK_RELEASE="$(
    rpm -qp \
        --qf '%{RELEASE}' \
        "${BUILT_RPM}"
)"

CHECK_ARCH="$(
    rpm -qp \
        --qf '%{ARCH}' \
        "${BUILT_RPM}"
)"

if [ "${CHECK_NAME}" != "${APP_NAME}" ]; then

    die "RPM internal name is ${CHECK_NAME}, expected ${APP_NAME}."

fi

if [ "${CHECK_VERSION}" != "${VERSION}" ]; then

    die "RPM version is ${CHECK_VERSION}, expected ${VERSION}."

fi

if [ "${CHECK_ARCH}" != "${ARCHITECTURE}" ]; then

    die "RPM architecture is ${CHECK_ARCH}, expected ${ARCHITECTURE}."

fi

echo "✅ RPM metadata verified."

# ============================================================
# Verify package contents
# ============================================================

echo
echo "🔍 Verifying RPM contents..."

RPM_CONTENTS="$(
    rpm -qpl "${BUILT_RPM}"
)"

if ! grep -qx '/usr/bin/sarabis' <<< "${RPM_CONTENTS}"; then

    die "/usr/bin/sarabis is missing from RPM."

fi

echo "✅ /usr/bin/sarabis"

if ! grep -qx '/usr/share/sarabis/app/main.py' <<< "${RPM_CONTENTS}"; then

    die "/usr/share/sarabis/app/main.py is missing from RPM."

fi

echo "✅ /usr/share/sarabis/app/main.py"

if ! grep -qx '/etc/sarabis/settings.py' <<< "${RPM_CONTENTS}"; then

    die "/etc/sarabis/settings.py is missing from RPM."

fi

echo "✅ /etc/sarabis/settings.py"

if ! grep -qx '/usr/share/applications/sarabis.desktop' <<< "${RPM_CONTENTS}"; then

    die "Desktop launcher is missing from RPM."

fi

echo "✅ /usr/share/applications/sarabis.desktop"

if ! grep -qx '/usr/lib/systemd/system/sarabis.service' <<< "${RPM_CONTENTS}"; then

    die "systemd service is missing from RPM."

fi

echo "✅ /usr/lib/systemd/system/sarabis.service"

# ============================================================
# Copy final RPM
# ============================================================

echo
echo "📦 Copying final RPM..."

rm -f "${PACKAGE_FILE}"

cp \
    "${BUILT_RPM}" \
    "${PACKAGE_FILE}"

chmod 644 "${PACKAGE_FILE}"

echo "✅ Final RPM created:"
echo
echo "   ${PACKAGE_FILE}"

# ============================================================
# RPM information
# ============================================================

echo
echo "============================================================"
echo "                 RPM PACKAGE INFORMATION"
echo "============================================================"
echo

rpm -qpi "${PACKAGE_FILE}"

# ============================================================
# Important contents
# ============================================================

echo
echo "============================================================"
echo "                 PACKAGE CONTENTS"
echo "============================================================"
echo

rpm -qpl "${PACKAGE_FILE}" |
    grep -E \
        '^/usr/bin/sarabis$|^/usr/share/sarabis/app/main.py$|^/usr/share/applications/sarabis.desktop$|^/etc/sarabis/settings.py$|^/usr/lib/systemd/system/sarabis.service$' \
        || true

# ============================================================
# Final result
# ============================================================

echo
echo "============================================================"
echo "              BUILD SUCCESSFUL"
echo "============================================================"
echo
echo "RPM:"
echo
echo "  ${PACKAGE_FILE}"
echo
echo "Install:"
echo
echo "  sudo zypper install ./${PACKAGE_FILE}"
echo
echo "Run:"
echo
echo "  sarabis"
echo
echo "Web:"
echo
echo "  ${APP_URL}"
echo
echo "Configuration:"
echo
echo "  /etc/sarabis/settings.py"
echo
echo "Application:"
echo
echo "  /usr/share/sarabis/"
echo
echo "Data:"
echo
echo "  /var/lib/sarabis/"
echo
echo "Logs:"
echo
echo "  /var/lib/sarabis/logs/sarabis.log"
echo
echo "============================================================"

