#!/bin/bash

# build_deb.sh - Fixed version for app/ structure

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${GREEN}🚀 Building .deb package for sarabis Security Analyzer${NC}"

# Configuration
APP_NAME="sarabis"
VERSION="1.0.0"
MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="sarabis Security Analyzer - Comprehensive remote Linux system security analysis platform"
ARCHITECTURE="all"
DEB_DIR="deb_package"
DEB_ROOT="${DEB_DIR}/${APP_NAME}_${VERSION}_${ARCHITECTURE}"

# Clean previous builds
echo -e "${YELLOW}🧹 Cleaning previous builds...${NC}"
rm -rf ${DEB_DIR}
rm -f ${APP_NAME}_*.deb

# Create package structure
echo -e "${YELLOW}📁 Creating package structure...${NC}"
mkdir -p ${DEB_ROOT}/DEBIAN
mkdir -p ${DEB_ROOT}/usr/share/${APP_NAME}
mkdir -p ${DEB_ROOT}/usr/bin
mkdir -p ${DEB_ROOT}/usr/share/applications
mkdir -p ${DEB_ROOT}/usr/share/doc/${APP_NAME}
mkdir -p ${DEB_ROOT}/etc/${APP_NAME}
mkdir -p ${DEB_ROOT}/var/log/${APP_NAME}
mkdir -p ${DEB_ROOT}/var/lib/${APP_NAME}/uploads
mkdir -p ${DEB_ROOT}/var/lib/${APP_NAME}/reports

# Create control file
echo -e "${YELLOW}📝 Creating control file...${NC}"
cat > ${DEB_ROOT}/DEBIAN/control << EOF
Package: ${APP_NAME}
Version: ${VERSION}
Section: utils
Priority: optional
Architecture: ${ARCHITECTURE}
Maintainer: ${MAINTAINER}
Description: ${DESCRIPTION}
Depends: python3, python3-pip, python3-venv, python3-dev, gcc, g++, openssh-client
Homepage: https://github.com/KooshaYeganeh/sarabis
EOF

# Create pre-installation script
cat > ${DEB_ROOT}/DEBIAN/preinst << 'EOF'
#!/bin/bash
set -e

echo "🔧 Preparing to install sarabis Security Analyzer..."

# Check if Python 3 is installed
if ! command -v python3 &> /dev/null; then
    echo "❌ Python 3 is required but not installed."
    echo "Install it with: sudo apt-get install python3 python3-pip python3-venv"
    exit 1
fi

# Create necessary directories
mkdir -p /usr/share/sarabis
mkdir -p /var/log/sarabis
mkdir -p /var/lib/sarabis/uploads
mkdir -p /var/lib/sarabis/reports

echo "✅ Pre-installation checks passed"
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/preinst

# Create post-installation script
cat > ${DEB_ROOT}/DEBIAN/postinst << 'EOF'
#!/bin/bash
set -e

echo "🔧 Setting up sarabis Security Analyzer..."

APP_DIR="/usr/share/sarabis"

# Create necessary directories
mkdir -p /var/log/sarabis
mkdir -p /var/lib/sarabis/uploads
mkdir -p /var/lib/sarabis/reports

# Check if Python 3 is available
if ! command -v python3 &> /dev/null; then
    echo "❌ Python 3 is not installed."
    exit 1
fi

# Ensure pip is available
if ! command -v pip3 &> /dev/null; then
    echo "📦 Installing pip3..."
    apt-get update && apt-get install -y python3-pip python3-venv python3-dev
fi

# Change to app directory
cd /usr/share/sarabis

# Remove existing virtual environment if it exists
rm -rf venv

# Create virtual environment
echo "🐍 Creating Python virtual environment..."
python3 -m venv venv

# Activate virtual environment and install packages
echo "📦 Installing Python packages..."
source venv/bin/activate

# Upgrade pip
pip install --upgrade pip

# Install Python dependencies from requirements.txt
if [ -f "requirements.txt" ]; then
    echo "📦 Installing from requirements.txt..."
    pip install -r requirements.txt
else
    echo "⚠️  requirements.txt not found! Installing common packages..."
    pip install flask paramiko pandas numpy scikit-learn joblib gunicorn werkzeug flask-session cryptography bcrypt
fi

deactivate

# Create settings.py template if it doesn't exist
if [ ! -f "/etc/sarabis/settings.py" ]; then
    echo "📝 Creating default configuration..."
    cat > /etc/sarabis/settings.py << 'SETTINGS'
# sarabis Security Analyzer - Configuration File
import os

# SSH Configuration (CHANGE THESE!)
SSH_HOST = "192.168.1.100"
SSH_PORT = 22
SSH_USERNAME = "your_username"
SSH_PASSWORD = "your_password"
SSH_KEY = None

# Session Configuration
SESSION_TYPE = 'filesystem'
SESSION_PERMANENT = False
PERMANENT_SESSION_LIFETIME = 3600

# Paths
LOG_DIR = '/var/log/sarabis'
REPORT_DIR = os.path.join(LOG_DIR, 'reports')

# Cache Settings
CACHE_TTL = 300
CACHE_MAX_SIZE = 100

# Security Settings
SECRET_KEY = 'change-this-secret-key-in-production'
PASSWORD_HASH = 'bcrypt'

# Flask Settings
HOST = '0.0.0.0'
PORT = 5050
DEBUG = False
SETTINGS
    echo "ℹ️  Default configuration created at /etc/sarabis/settings.py"
fi

# Create launcher script - FIXED to point to app/main.py
cat > /usr/bin/sarabis << 'LAUNCHER'
#!/bin/bash
cd /usr/share/sarabis
export PYTHONPATH=/usr/share/sarabis
source venv/bin/activate
export FLASK_APP=app/main.py
export FLASK_ENV=production
export HERMES_CONFIG=/etc/sarabis/settings.py
exec python app/main.py "$@"
LAUNCHER

chmod 755 /usr/bin/sarabis

# Create systemd service file - FIXED to point to app/main.py
cat > /etc/systemd/system/sarabis.service << 'SERVICE'
[Unit]
Description=sarabis Security Analyzer Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/share/sarabis
Environment="PATH=/usr/share/sarabis/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=app/main.py"
Environment="FLASK_ENV=production"
Environment="HERMES_CONFIG=/etc/sarabis/settings.py"
Environment="PYTHONPATH=/usr/share/sarabis"
ExecStart=/usr/share/sarabis/venv/bin/python /usr/share/sarabis/app/main.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/sarabis/access.log
StandardError=append:/var/log/sarabis/error.log

[Install]
WantedBy=multi-user.target
SERVICE

# Reload systemd
systemctl daemon-reload

# Set permissions
chown -R root:root /usr/share/sarabis
chmod 755 /usr/share/sarabis
chmod -R 755 /usr/share/sarabis/app
chmod 755 /var/log/sarabis
chmod 755 /var/lib/sarabis/uploads
chmod 755 /var/lib/sarabis/reports
chmod 644 /etc/sarabis/settings.py

# Create admin credentials file
echo "🔐 Default credentials: admin/admin (CHANGE IMMEDIATELY!)"
cat > /usr/share/sarabis/.admin_credentials << 'CRED'
Username: admin
Password: admin
⚠️  CHANGE THESE CREDENTIALS IMMEDIATELY!
CRED

echo ""
echo "✅ Installation complete!"
echo ""
echo "📋 To run the app directly:"
echo "  sarabis"
echo ""
echo "🔗 Or use systemd service:"
echo "  sudo systemctl start sarabis"
echo "  sudo systemctl enable sarabis"
echo ""
echo "🌐 The application will be available at: http://localhost:5050"
echo ""
echo "🔐 Default credentials: admin/admin (CHANGE IMMEDIATELY!)"
echo ""
echo "📝 Configuration: /etc/sarabis/settings.py"
echo "📊 Reports: /var/lib/sarabis/reports/"
echo "📝 Logs: /var/log/sarabis/"
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/postinst

# POST-REMOVAL SCRIPT
cat > ${DEB_ROOT}/DEBIAN/postrm << 'EOF'
#!/bin/bash
set -e

echo "🧹 Removing sarabis Security Analyzer..."

# Stop service if running
systemctl stop sarabis 2>/dev/null || true
systemctl disable sarabis 2>/dev/null || true

# Remove systemd service
rm -f /etc/systemd/system/sarabis.service
systemctl daemon-reload 2>/dev/null || true

# Remove launcher
rm -f /usr/bin/sarabis

# Ask about removing data
read -p "Remove application data and virtual environment? (y/N): " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    rm -rf /usr/share/sarabis
    rm -rf /var/log/sarabis
    rm -rf /var/lib/sarabis
    rm -rf /etc/sarabis
    echo "✅ Data removed"
else
    echo "ℹ️ Data preserved in /usr/share/sarabis"
fi
EOF

chmod 755 ${DEB_ROOT}/DEBIAN/postrm

# --- FILE COPYING SECTION (FIXED FOR app/ STRUCTURE) ---
echo -e "${YELLOW}📦 Copying application files...${NC}"

# Copy the entire app directory (this contains main.py and everything else)
if [ -d "app" ]; then
    echo -e "${YELLOW}📁 Copying app directory...${NC}"
    cp -rf app ${DEB_ROOT}/usr/share/${APP_NAME}/
else
    echo -e "${RED}❌ ERROR: app directory not found!${NC}"
    exit 1
fi

# Copy requirements.txt
if [ -f "requirements.txt" ]; then
    echo -e "${YELLOW}📦 Copying requirements.txt...${NC}"
    cp requirements.txt ${DEB_ROOT}/usr/share/${APP_NAME}/
else
    echo -e "${YELLOW}⚠️  requirements.txt not found, creating default...${NC}"
    cat > ${DEB_ROOT}/usr/share/${APP_NAME}/requirements.txt << 'REQ'
flask>=2.3.0
paramiko>=3.0.0
pandas>=2.0.0
numpy>=1.24.0
scikit-learn>=1.3.0
joblib>=1.3.0
gunicorn>=20.0.0
werkzeug>=2.3.0
flask-session>=0.5.0
cryptography>=41.0.0
bcrypt>=4.0.0
REQ
fi

# Copy any other files in root that might be needed
echo -e "${YELLOW}📄 Copying additional files...${NC}"
for file in setup.py LICENSE README.md; do
    if [ -f "$file" ]; then
        echo -e "${BLUE}  Copying $file...${NC}"
        cp "$file" ${DEB_ROOT}/usr/share/${APP_NAME}/ 2>/dev/null || true
    fi
done

# Copy settings.py if it exists in app directory (but we already copied app/)
if [ -f "app/settings.py" ]; then
    echo -e "${YELLOW}📄 Found settings.py in app directory${NC}"
fi

# Verify main.py exists in the app directory
if [ ! -f "${DEB_ROOT}/usr/share/${APP_NAME}/app/main.py" ]; then
    echo -e "${RED}❌ ERROR: app/main.py not found in package!${NC}"
    echo -e "${YELLOW}Please make sure app/main.py exists.${NC}"
    exit 1
fi

echo -e "${GREEN}✅ main.py found at: ${DEB_ROOT}/usr/share/${APP_NAME}/app/main.py${NC}"

# Create __init__.py in app directory if missing
if [ ! -f ${DEB_ROOT}/usr/share/${APP_NAME}/app/__init__.py ]; then
    echo -e "${YELLOW}📄 Creating app/__init__.py...${NC}"
    touch ${DEB_ROOT}/usr/share/${APP_NAME}/app/__init__.py
fi

# Create README
cat > ${DEB_ROOT}/usr/share/doc/${APP_NAME}/README << 'EOF'
sarabis Security Analyzer
========================
A Comprehensive Remote System Security Analysis Platform

Quick Start
-----------
1. Edit configuration: sudo nano /etc/sarabis/settings.py
   (Update SSH credentials for your target systems)

2. Run the application:
   $ sarabis

3. Or use systemd:
   $ sudo systemctl start sarabis
   $ sudo systemctl enable sarabis

4. Access: http://localhost:5050

Default Credentials:
   Username: admin
   Password: admin
   ⚠️  CHANGE THESE IMMEDIATELY!

Features
--------
- Vulnerability Scanning (CVE detection)
- Port Analysis with risk scoring
- Service and Process Analysis
- Kernel Module Analysis
- Software Audit
- User Analysis
- Hardening Checks

For more info: https://github.com/KYGnus/sarabis
EOF

# Create .desktop file
cat > ${DEB_ROOT}/usr/share/applications/sarabis.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=sarabis Security Analyzer
Comment=Comprehensive Linux Security Analysis Platform
Exec=sarabis
Icon=security
Terminal=false
Categories=Network;Security;System;
Keywords=security;analysis;audit;ssh;scanning
EOF

# Set proper permissions
echo -e "${YELLOW}🔧 Setting permissions...${NC}"
find ${DEB_ROOT} -type d -exec chmod 755 {} \;
find ${DEB_ROOT} -name "*.py" -exec chmod 644 {} \;
find ${DEB_ROOT} -name "*.sh" -exec chmod 755 {} \;
chmod 755 ${DEB_ROOT}/usr/share/${APP_NAME}/app/main.py 2>/dev/null || true

# Build the .deb package
echo -e "${YELLOW}🔨 Building .deb package...${NC}"
cd ${DEB_DIR}
dpkg-deb --build ${APP_NAME}_${VERSION}_${ARCHITECTURE}
cd ..

# Move the .deb to root directory
mv ${DEB_DIR}/${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb .

# Clean up
rm -rf ${DEB_DIR}

echo -e "${GREEN}✅ Successfully created: ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb${NC}"
echo -e "${GREEN}📦 Package size: $(du -h ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb | cut -f1)${NC}"
echo ""
echo -e "${GREEN}To install:${NC}"
echo "  sudo dpkg -i ${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb"
echo "  sudo apt-get install -f  # if needed"
echo ""
echo -e "${GREEN}Or with apt:${NC}"
echo "  sudo apt-get install ./${APP_NAME}_${VERSION}_${ARCHITECTURE}.deb"
echo ""
echo -e "${YELLOW}After installation:${NC}"
echo "  1. Edit /etc/sarabis/settings.py with your SSH credentials"
echo "  2. Start: sudo systemctl start sarabis"
echo "  3. Access: http://localhost:5050"
echo "  4. Login: admin/admin (CHANGE IMMEDIATELY!)"
